{"schema_version":"public-data-geospatial-provider-catalog-v1","secret_values_exposed":false,"replaced_legacy_connectors":[],"providers":[{"provider_id":"public-data-geospatial","display_name":"全球公共数据、空间地理与中国数据","description":"统一开放免费或有免费额度的全球公共数据、空间地理、道路交通及中国大陆官方数据能力。","enabled":true,"ticket_prefix":"[intel-public-data]","required_secret_environment_variable":"","catalog_policy":"仅允许调用代码内固定官方主机和固定只读端点；禁止任意 URL、任意请求头、自动翻页、批量镜像、登录绕过、写入、交易或个人数据查询。","execution_policy":"每张票据最多执行一次上游只读请求；密钥和用户名仅由后端环境注入；无密钥操作可直接运行，有密钥操作缺少相应字段时结构化失败。","limits":{"requests_per_ticket_max":1,"automatic_retry_allowed":false,"automatic_pagination_allowed":false,"redirects_allowed":false,"arbitrary_urls_allowed":false,"arbitrary_headers_allowed":false,"write_operations_allowed":false,"secret_values_exposed":false,"optional_secret_environment_variables":["OPENROUTESERVICE_API_KEY","GEONAMES_USERNAME","OPENAQ_API_KEY","OPENFDA_API_KEY","RELIEFWEB_APPNAME","HDX_HAPI_APP_IDENTIFIER","IATI_API_KEY","COMPANIES_HOUSE_API_KEY","SAM_GOV_API_KEY","OPENTOPOGRAPHY_API_KEY","GLOBAL_FISHING_WATCH_API_TOKEN","OPENCHARGEMAP_API_KEY","TRANSITLAND_API_KEY"],"noncommercial_only_operations":["global-fishing-watch-vessels"],"china_first_operations":["nbs-search","nbs-query-data","nbs-new-tree","nbs-new-indicators","china-local-open-data-catalog","china-science-data-centers"]},"operations":[{"operation_id":"catalog-capabilities","description":"读取本地能力、鉴权字段和使用限制目录。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"","http_method":"GET","read_only":true},"discovery_policy":{"source":"official-documentation"}},{"operation_id":"ilostat-dataflows","description":"读取 ILOSTAT 官方 SDMX 数据流目录。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"https://sdmx.ilo.org/rest/dataflow/all/all/latest","http_method":"GET","read_only":true},"discovery_policy":{"sour