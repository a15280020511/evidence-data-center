{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/evidence-data-center/api-center/hexdb-aviation/ticket.schema.json",
  "title": "HexDB aviation metadata bounded read-only ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "provider",
    "operation",
    "objective",
    "parameters",
    "data_policy",
    "acceptance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "provider": {
      "const": "hexdb-aviation"
    },
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "aircraft-by-icao24",
        "route-by-icao-callsign",
        "route-by-iata-callsign",
        "airport-by-icao",
        "airport-by-iata"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "parameters": {
      "type": "object",
      "maxProperties": 1
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "contains_personal_data"
      ],
      "properties": {
        "classification": {
          "const": "public"
        },
        "contains_personal_data": {
          "const": false
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_response_bytes"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 2000000
        }
      }
    }
  }
}
