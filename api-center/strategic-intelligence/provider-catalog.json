{
  "schema_version": "strategic-intelligence-provider-catalog-v1",
  "secret_values_exposed": false,
  "providers": [
    {
      "provider_id": "strategic-intelligence-open-data",
      "display_name": "战略情报固定开放数据",
      "description": "提供灾害声明、互联网路由、网络互联设施和ATT&CK集合索引的固定只读能力。",
      "enabled": true,
      "ticket_prefix": "[intel-strategic-source]",
      "required_secret_environment_variable": "",
      "catalog_policy": "仅允许代码内固定官方主机、固定路径和受限参数；禁止任意URL、请求头、翻页循环、持续流、写入和个人画像。",
      "execution_policy": "每张票据最多一次上游请求；无自动重试、无自动翻页、无重定向；响应体和超时受票据上限约束。",
      "limits": {
        "requests_per_ticket_max": 1,
        "timeout_seconds_max": 90,
        "max_response_bytes": 10000000,
        "automatic_retry_allowed": false,
        "automatic_pagination_allowed": false,
        "redirects_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_headers_allowed": false,
        "write_operations_allowed": false,
        "secret_values_exposed": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地能力目录，不访问上游。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}},
          "result_contract": {"official_endpoint": "LOCAL", "http_method": "LOCAL", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "source-access-matrix",
          "description": "读取来源、费用、许可、生产状态和候选条件矩阵。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}},
          "result_contract": {"official_endpoint": "LOCAL", "http_method": "LOCAL", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "openfema-disaster-declarations",
          "description": "查询OpenFEMA官方灾害声明摘要。",
          "parameters": ["state", "incident_type", "year_from", "year_to", "top", "skip"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
              "incident_type": {"type": "string", "minLength": 2, "maxLength": 80},
              "year_from": {"type": "integer", "minimum": 1953, "maximum": 2100},
              "year_to": {"type": "integer", "minimum": 1953, "maximum": 2100},
              "top": {"type": "integer", "minimum": 1, "maximum": 1000},
              "skip": {"type": "integer", "minimum": 0, "maximum": 100000}
            }
          },
          "result_contract": {"official_endpoint": "https://www.fema.gov/api/open/v2/DisasterDeclarationsSummaries", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "ripestat-network-info",
          "description": "读取IP地址所在前缀和通告ASN。",
          "parameters": ["resource"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "required": ["resource"], "properties": {"resource": {"type": "string", "minLength": 3, "maxLength": 128}}},
          "result_contract": {"official_endpoint": "https://stat.ripe.net/data/network-info/data.json", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "ripestat-prefix-overview",
          "description": "读取IP前缀、通告状态及相关ASN概览。",
          "parameters": ["resource"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "required": ["resource"], "properties": {"resource": {"type": "string", "minLength": 3, "maxLength": 128}}},
          "result_contract": {"official_endpoint": "https://stat.ripe.net/data/prefix-overview/data.json", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "ripestat-as-overview",
          "description": "读取自治系统名称、持有者和资源概览。",
          "parameters": ["resource"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "required": ["resource"], "properties": {"resource": {"type": "string", "pattern": "^(?:AS)?[0-9]{1,10}$"}}},
          "result_contract": {"official_endpoint": "https://stat.ripe.net/data/as-overview/data.json", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "ripestat-bgp-state",
          "description": "读取指定资源在给定时间的BGP路由状态。",
          "parameters": ["resource", "timestamp"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "required": ["resource"], "properties": {"resource": {"type": "string", "minLength": 3, "maxLength": 256}, "timestamp": {"type": "string", "minLength": 10, "maxLength": 40}}},
          "result_contract": {"official_endpoint": "https://stat.ripe.net/data/bgp-state/data.json", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "peeringdb-search",
          "description": "按名称和国家检索网络、交换中心、设施或组织。",
          "parameters": ["object_type", "name", "country", "limit"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_type", "name"],
            "properties": {
              "object_type": {"type": "string", "enum": ["net", "ix", "fac", "org"]},
              "name": {"type": "string", "minLength": 1, "maxLength": 120},
              "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
              "limit": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          },
          "result_contract": {"official_endpoint": "https://www.peeringdb.com/api/{object_type}", "http_method": "GET", "read_only": true, "credential_mode": "anonymous"}
        },
        {
          "operation_id": "peeringdb-object",
          "description": "按固定对象类型和数值ID读取单个PeeringDB对象。",
          "parameters": ["object_type", "object_id"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "required": ["object_type", "object_id"], "properties": {"object_type": {"type": "string", "enum": ["net", "ix", "fac", "org"]}, "object_id": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
          "result_contract": {"official_endpoint": "https://www.peeringdb.com/api/{object_type}/{object_id}", "http_method": "GET", "read_only": true, "credential_mode": "anonymous"}
        },
        {
          "operation_id": "mitre-attack-index",
          "description": "读取MITRE ATT&CK STIX 2.1集合索引，不下载完整大型知识库。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}},
          "result_contract": {"official_endpoint": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/index.json", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        }
      ]
    }
  ]
}
