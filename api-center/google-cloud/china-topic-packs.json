{
  "schema_version": "google-china-topic-packs-v2",
  "selection_owner": "gpts-usage-center",
  "execution_owner": "api-center",
  "public_non_personal_data_only": true,
  "direct_compute_or_expert_dispatch_allowed": false,
  "rules": [
    "GPTs must inspect live dataset or table metadata before executing a query.",
    "All results must preserve dataset ID, table ID, observation date, unit, license and source provenance when available.",
    "Global coverage does not guarantee equal quality or freshness inside every part of China.",
    "API center only returns snapshots; GPTs decides whether to pass a verified snapshot to the independent compute center.",
    "Raster products are proxies or modeled observations and must be calibrated against authoritative Chinese observations for decision-grade use."
  ],
  "packs": [
    {
      "pack_id": "china-patent-intelligence",
      "provider": "bigquery",
      "project_id": "patents-public-data",
      "discovery_sequence": [
        {"operation": "catalog-datasets", "parameters": {"project_id": "patents-public-data"}},
        {"operation": "catalog-tables", "parameters": {"project_id": "patents-public-data", "dataset_id": "patents"}},
        {"operation": "catalog-table", "parameters": {"project_id": "patents-public-data", "dataset_id": "patents", "table_id": "publications"}},
        {"operation": "query-readonly", "parameters": {"location": "US", "maximum_bytes_billed": 1000000000, "max_rows": 1000}}
      ],
      "primary_table_hint": "patents-public-data.patents.publications",
      "china_filters": ["inventor or assignee country code CN", "publication or filing jurisdiction CN", "Chinese applicant or assignee names"],
      "use_cases": ["中国企业技术路线", "专利申请趋势", "竞争对手研发方向", "专利引用网络", "新兴技术发现"],
      "limitations": ["必须先读取实时表结构，不能永久假设字段布局", "专利数量不等于专利质量", "同族专利、法律状态和申请人名称需要去重与标准化"]
    },
    {
      "pack_id": "china-news-events-risk",
      "provider": "bigquery",
      "project_id": "gdelt-bq",
      "discovery_sequence": [
        {"operation": "catalog-datasets", "parameters": {"project_id": "gdelt-bq"}},
        {"operation": "catalog-tables", "parameters": {"project_id": "gdelt-bq", "dataset_id": "gdeltv2"}},
        {"operation": "query-readonly", "parameters": {"location": "US", "maximum_bytes_billed": 1000000000, "max_rows": 1000}}
      ],
      "dataset_hint": "gdelt-bq.gdeltv2",
      "china_filters": ["ActionGeo_CountryCode=CH", "Actor country codes for China", "Chinese-language sources", "China-related themes or entities"],
      "use_cases": ["中国政策与企业舆情", "地区事件趋势", "国际关系事件", "风险指标与预警", "异常媒体关注度"],
      "limitations": ["GDELT是机器编码事件和媒体数据，必须回看原始报道", "报道数量不等于事件严重度", "国家代码、主题和情绪字段必须按实时表结构核验"]
    },
    {
