{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/global-public-specialized-ticket.schema.json",
  "title": "Global Public Specialized APIs Ticket",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider": {
      "const": "global-public-specialized-apis"
    },
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "source-access-matrix",
        "poland-isztar4-help",
        "poland-isztar4-tariff-sections",
        "korea-krx-listed-companies"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "EN",
            "PL"
          ]
        },
        "simulation_date": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "base_date": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "company_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "classification": {
          "const": "public"
        },
        "contains_personal_data": {
          "const": false
        }
      },
      "required": [
        "classification",
        "contains_personal_data"
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 90
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        }
      }
    }
  },
  "required": [
    "task_id",
    "provider",
    "operation",
    "objective",
    "parameters",
    "data_policy",
    "acceptance"
  ]
}
