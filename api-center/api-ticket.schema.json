{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/test/api-center/api-ticket.schema.json",
  "title": "Independent API Center Ticket",
  "description": "A public-data API request prepared by GPTs. API, compute, and expert centers never call each other directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "objective",
    "data_policy",
    "requests",
    "acceptance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_id",
        "stage_id"
      ],
      "properties": {
        "pipeline_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "sequence_reason": {
          "type": "string",
          "maxLength": 2000
        },
        "upstream_refs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "center",
              "task_id",
              "file",
              "sha256"
            ],
            "properties": {
              "center": {
                "enum": [
                  "api",
                  "compute",
                  "expert",
                  "user",
                  "public_source"
                ]
              },
              "task_id": {
                "type": "string",
                "maxLength": 128
              },
              "issue_number": {
                "type": "integer",
                "minimum": 1
              },
              "run_id": {
                "type": "integer",
                "minimum": 1
              },
              "artifact_id": {
                "type": "integer",
                "minimum": 1
              },
              "file": {
                "type": "string",
                "maxLength": 500
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observed_at": {
                "type": "string",
                "maxLength": 100
              }
            }
          }
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "contains_personal_data"
      ],
      "properties": {
        "classification": {
          "const": "public"
        },
        "contains_personal_data": {
          "const": false
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "connector_id",
          "parameters"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
          },
          "connector_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "parameters": {
            "type": "object",
            "maxProperties": 50,
            "propertyNames": {
              "pattern": "^[A-Za-z0-9._~-]{1,64}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4096
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "allow_empty": {
            "type": "boolean",
            "default": false
          },
          "quality_checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expected_location": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "latitude",
                  "longitude",
                  "max_distance_km"
                ],
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "max_distance_km": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 20000
                  },
                  "admin_tokens": {
                    "type": "array",
                    "maxItems": 20,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_all",
        "minimum_successful_requests"
      ],
      "properties": {
        "require_all": {
          "type": "boolean"
        },
        "minimum_successful_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 15
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "default": 2
        },
        "max_response_bytes_per_request": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 100000,
          "default": 100000
        }
      }
    }
  }
}
