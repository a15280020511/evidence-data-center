{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/evidence-data-center/api-center/copernicus/ticket.schema.json",
  "title": "Copernicus Data Space bounded read-only ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "provider",
    "operation",
    "objective",
    "parameters",
    "data_policy",
    "acceptance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "provider": {
      "const": "copernicus-cdse"
    },
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "stac-list-collections",
        "stac-search-items",
        "stac-get-item",
        "render-true-color-png",
        "render-false-color-png",
        "render-ndvi-png"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "parameters": {
      "type": "object",
      "maxProperties": 7
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "contains_personal_data"
      ],
      "properties": {
        "classification": {
          "const": "public"
        },
        "contains_personal_data": {
          "const": false
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_response_bytes",
        "max_rows"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 30000000
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  },
  "$defs": {
    "collection": {
      "type": "string",
      "enum": [
        "sentinel-1-grd",
        "sentinel-2-l1c",
        "sentinel-2-l2a",
        "sentinel-2-global-mosaics"
      ]
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "renderParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "start_time": {
          "$ref": "#/$defs/timestamp"
        },
        "end_time": {
          "$ref": "#/$defs/timestamp"
        },
        "cloud_cover_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mosaicking_order": {
          "type": "string",
          "enum": [
            "leastCC",
            "mostRecent",
            "leastRecent"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        }
      },
      "required": [
        "bbox",
        "start_time",
        "end_time"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "catalog-capabilities",
              "stac-list-collections"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "stac-search-items"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "collection": {
                "$ref": "#/$defs/collection"
              },
              "bbox": {
                "$ref": "#/$defs/bbox"
              },
              "start_time": {
                "$ref": "#/$defs/timestamp"
              },
              "end_time": {
                "$ref": "#/$defs/timestamp"
              },
              "cloud_cover_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "collection",
              "bbox",
              "start_time",
              "end_time"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "stac-get-item"
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "collection": {
                "$ref": "#/$defs/collection"
              },
              "item_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,255}$"
              }
            },
            "required": [
              "collection",
              "item_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "render-true-color-png",
              "render-false-color-png",
              "render-ndvi-png"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "$ref": "#/$defs/renderParameters"
          }
        }
      }
    }
  ]
}
