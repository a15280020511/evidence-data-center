      "public-source graph construction, source comparison, entity candidate generation and quality diagnostics",
      "safe read-only APIs and remote MCP tools with fixed capabilities"
    ],
    "must_be_delegated_to_compute_center": [
      "formal statistical inference", "causal conclusions", "optimization", "simulation", "policy counterfactuals", "portfolio optimization", "agent-based modeling", "strategic game analysis", "final predictive model selection"
    ],
