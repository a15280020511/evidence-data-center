{
  "schema_version": "wto-provider-catalog-v1",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "wto",
      "display_name": "WTO Timeseries 国际贸易与关税统计",
      "description": "通过 WTO 官方 Timeseries API 读取贸易、关税、市场准入、非关税措施及相关指标。",
      "enabled": true,
      "ticket_prefix": "[intel-wto]",
      "required_secret_environment_variable": "WTO_API_KEY",
      "catalog_policy": "固定访问 api.wto.org/timeseries/v1；订阅密钥仅经后端请求头发送。",
      "execution_policy": "每张票据最多一次 GET；无重试、无自动翻页、最多500条。",
      "official_documentation": "https://apiportal.wto.org/",
      "official_origin": "https://api.wto.org/timeseries/v1",
      "limits": {
        "requests_per_ticket_max": 1,
        "transient_retry_max": 0,
        "provider_concurrency_max": 1,
        "timeout_seconds_max": 60,
        "max_response_bytes": 20000000,
        "records_per_ticket_max": 500,
        "fixed_api_host": "api.wto.org",
        "fixed_api_prefix": "/timeseries/v1",
        "automatic_retry_allowed": false,
        "automatic_pagination_allowed": false,
        "bulk_download_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_hosts_allowed": false,
        "arbitrary_headers_allowed": false,
        "client_supplied_credentials_allowed": false,
        "write_operations_allowed": false,
        "secret_values_exposed": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地 WTO 能力目录。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "wto",
            "http_method": "LOCAL",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "indicator-categories",
          "description": "读取 WTO 指标分类。",
          "parameters": [
            "lang"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lang": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              }
            }
          },
          "result_contract": {
            "provider": "wto",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "subscription_key_header"
          }
        },
        {
          "operation_id": "indicators",
          "description": "读取 WTO 指标目录。",
          "parameters": [
            "lang"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
