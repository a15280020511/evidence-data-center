                  3
                ]
              }
            }
          },
          "result_contract": {
            "provider": "wto",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "subscription_key_header"
          }
        },
        {
          "operation_id": "reporters",
          "description": "读取报告经济体目录。",
          "parameters": [
            "lang"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lang": {
                "type": "integer",
                "enum": [
                  1,
                  2,
