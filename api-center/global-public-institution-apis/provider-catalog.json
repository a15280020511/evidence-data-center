{
  "schema_version": "global-public-institution-provider-catalog-v2",
  "secret_values_exposed": false,
  "providers": [
    {
      "provider_id": "global-public-institution-apis",
      "display_name": "全球公共机构与科研数据库API",
      "description": "固定接入国家开放数据、统计机构、大学科研仓库、专业科研数据库、政府API目录和官方统计发布入口的只读公共接口。",
      "enabled": true,
      "ticket_prefix": "[intel-public-institution]",
      "required_secret_environment_variable": "",
      "optional_secret_environment_variables": [
        "SINGAPORE_DATA_GOV_API_KEY",
        "BPS_API_KEY",
        "ESTAT_APP_ID",
        "MATERIALS_PROJECT_API_KEY",
        "INDIA_DATA_GOV_API_KEY",
        "BRAZIL_DADOS_GOV_TOKEN",
        "KOREA_DATA_GO_KR_SERVICE_KEY"
      ],
      "catalog_policy": "只允许固定HTTPS主机、固定只读操作和后端密钥注入；禁止任意URL、任意路径、客户端密钥、写入、自动翻页、自动重试、重定向和个人画像。",
      "execution_policy": "每票最多一次上游请求；结果只保存公开元数据、聚合统计、官方目录或来源明确允许的公开科研属性；按来源保留许可和出处。",
      "limits": {
        "requests_per_ticket_max": 1,
        "timeout_seconds_max": 90,
        "max_response_bytes": 10000000,
        "automatic_pagination_allowed": false,
        "automatic_retry_allowed": false,
        "redirects_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_hosts_allowed": false,
        "arbitrary_paths_allowed": false,
        "arbitrary_headers_allowed": false,
        "client_supplied_credentials_allowed": false,
        "write_operations_allowed": false,
        "paywall_bypass_allowed": false,
        "personal_data_queries_allowed": false,
        "secret_values_exposed": false
      },
      "operations": [
        {"operation_id":"catalog-capabilities","description":"读取本地能力目录。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"LOCAL","http_method":"LOCAL","read_only":true,"credential_mode":"none"}},
        {"operation_id":"source-access-matrix","description":"读取来源、费用、Key、许可和生产状态矩阵。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"LOCAL","http_method":"LOCAL","read_only":true,"credential_mode":"none"}},
        {"operation_id":"singapore-collections","description":"列出Data.gov.sg公开数据集合。","parameters":["page"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"page":{"type":"integer","minimum":1,"maximum":100}}},"result_contract":{"official_endpoint":"https://api-production.data.gov.sg/v2/public/api/collections","http_method":"GET","read_only":true,"credential_mode":"optional-free-key"}},
        {"operation_id":"singapore-collection-metadata","description":"读取一个Data.gov.sg集合及其数据集元数据。","parameters":["collection_id","include_dataset_metadata"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"collection_id":{"type":"integer","minimum":1,"maximum":1000000000},"include_dataset_metadata":{"type":"boolean"}},"required":["collection_id"]},"result_contract":{"official_endpoint":"https://api-production.data.gov.sg/v2/public/api/collections/{collection_id}/metadata","http_method":"GET","read_only":true,"credential_mode":"optional-free-key"}},
        {"operation_id":"abs-dataflows","description":"读取澳大利亚ABS官方SDMX数据流目录。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"https://data.api.abs.gov.au/rest/dataflow/ABS/all/latest","http_method":"GET","read_only":true,"credential_mode":"none"}},
        {"operation_id":"abs-data","description":"读取一个固定ABS数据流的有限期数聚合统计。","parameters":["dataflow","data_key","last_n_observations"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"dataflow":{"type":"string","minLength":1,"maxLength":80,"pattern":"^[A-Z0-9_,.:-]+$"},"data_key":{"type":"string","minLength":1,"maxLength":300,"pattern":"^[A-Za-z0-9.*+_,:-]+$"},"last_n_observations":{"type":"integer","minimum":1,"maximum":24}},"required":["dataflow","data_key"]},"result_contract":{"official_endpoint":"https://data.api.abs.gov.au/rest/data/{dataflow}/{data_key}","http_method":"GET","read_only":true,"credential_mode":"none"}},
        {"operation_id":"cnra-dataset-search","description":"检索加州自然资源局CKAN公开数据目录。","parameters":["query","limit"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"query":{"type":"string","minLength":1,"maxLength":200},"limit":{"type":"integer","minimum":1,"maximum":50}},"required":["query"]},"result_contract":{"official_endpoint":"https://data.cnra.ca.gov/api/3/action/package_search","http_method":"GET","read_only":true,"credential_mode":"none"}},
        {"operation_id":"bps-domain-list","description":"读取印度尼西亚BPS国家、省和市县统计域目录。","parameters":["domain_type","province_code"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"domain_type":{"type":"string","enum":["all","prov","kab","kabbyprov"]},"province_code":{"type":"string","pattern":"^[0-9]{2,4}$"}}},"result_contract":{"official_endpoint":"https://webapi.bps.go.id/v1/api/domain","http_method":"GET","read_only":true,"credential_mode":"required-free-key"}},
        {"operation_id":"estat-stats-list","description":"检索日本e-Stat统计表目录。","parameters":["query","limit"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"query":{"type":"string","minLength":1,"maxLength":200},"limit":{"type":"integer","minimum":1,"maximum":100}},"required":["query"]},"result_contract":{"official_endpoint":"https://api.e-stat.go.jp/rest/3.0/app/json/getStatsList","http_method":"GET","read_only":true,"credential_mode":"required-free-app-id"}},
        {"operation_id":"estat-stats-data","description":"读取日本e-Stat指定统计表的有限记录。","parameters":["stats_data_id","limit"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"stats_data_id":{"type":"string","minLength":1,"maxLength":80,"pattern":"^[A-Za-z0-9_-]+$"},"limit":{"type":"integer","minimum":1,"maximum":1000}},"required":["stats_data_id"]},"result_contract":{"official_endpoint":"https://api.e-stat.go.jp/rest/3.0/app/json/getStatsData","http_method":"GET","read_only":true,"credential_mode":"required-free-app-id"}},
        {"operation_id":"materials-summary-search","description":"按化学体系检索Materials Project有限字段材料属性。","parameters":["chemical_system","limit"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"chemical_system":{"type":"string","minLength":1,"maxLength":60,"pattern":"^[A-Z][a-z]?(?:-[A-Z][a-z]?){0,7}$"},"limit":{"type":"integer","minimum":1,"maximum":20}},"required":["chemical_system"]},"result_contract":{"official_endpoint":"https://api.materialsproject.org/materials/summary/","http_method":"GET","read_only":true,"credential_mode":"required-free-key"}},
        {"operation_id":"india-resource-get","description":"读取印度开放数据平台一个已知资源的有限记录。","parameters":["resource_id","limit"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"resource_id":{"type":"string","pattern":"^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"},"limit":{"type":"integer","minimum":1,"maximum":50}},"required":["resource_id"]},"result_contract":{"official_endpoint":"https://api.data.gov.in/resource/{resource_id}","http_method":"GET","read_only":true,"credential_mode":"required-free-key"}},
        {"operation_id":"brazil-dataset-list","description":"列出巴西国家开放数据门户的公开数据集。","parameters":["query","page"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"query":{"type":"string","minLength":1,"maxLength":200},"page":{"type":"integer","minimum":1,"maximum":1000}}},"result_contract":{"official_endpoint":"https://dados.gov.br/dados/api/publico/conjuntos-dados","http_method":"GET","read_only":true,"credential_mode":"required-free-bearer-token"}},
        {"operation_id":"asu-dataverse-search","description":"检索亚利桑那州立大学Dataverse公开科研数据元数据。","parameters":["query","limit"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"query":{"type":"string","minLength":1,"maxLength":200},"limit":{"type":"integer","minimum":1,"maximum":50}},"required":["query"]},"result_contract":{"official_endpoint":"https://dataverse.asu.edu/api/search","http_method":"GET","read_only":true,"credential_mode":"none"}},
        {"operation_id":"asu-oai-identify","description":"读取ASU科研数据仓库OAI-PMH身份和协议能力。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"https://dataverse.asu.edu/oai","http_method":"GET","read_only":true,"credential_mode":"none"}},
        {"operation_id":"uk-api-catalogue-index","description":"读取英国公共部门API目录A-Z索引，用于发现并核验英国政府API。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"https://www.api.gov.uk/index/","http_method":"GET","read_only":true,"credential_mode":"none","discovery_only":true}},
        {"operation_id":"poland-isztar4-service-info","description":"读取波兰海关ISZTAR4官方网络服务说明和接口规范入口。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"https://puesc.gov.pl/en/uslugi/uslugi-sieciowe-informacje-i-specyfikacje/system-isztar4","http_method":"GET","read_only":true,"credential_mode":"none","contract_metadata_only":true}},
        {"operation_id":"ukraine-nipo-statistics","description":"读取乌克兰NIPO官方知识产权统计、月报和年度报告入口。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{}},"result_contract":{"official_endpoint":"https://nipo.gov.ua/en/statistics-reports/","http_method":"GET","read_only":true,"credential_mode":"none","publication_index":true}},
        {"operation_id":"korea-krx-listed-companies","description":"读取韩国公共数据门户金融委员会KRX上市公司和证券基础信息。","parameters":["page","limit","base_date","company_name"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"page":{"type":"integer","minimum":1,"maximum":1000},"limit":{"type":"integer","minimum":1,"maximum":100},"base_date":{"type":"string","pattern":"^[0-9]{8}$"},"company_name":{"type":"string","minLength":1,"maxLength":80}}},"result_contract":{"official_endpoint":"https://apis.data.go.kr/1160100/service/GetKrxListedInfoService/getItemInfo","http_method":"GET","read_only":true,"credential_mode":"required-free-service-key"}}
      ]
    }
  ]
}
