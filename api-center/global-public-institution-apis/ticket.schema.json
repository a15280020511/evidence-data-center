{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/global-public-institution-ticket.schema.json",
  "title": "Global Public Institution APIs Ticket",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider": {
      "const": "global-public-institution-apis"
    },
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "source-access-matrix",
        "singapore-collections",
        "singapore-collection-metadata",
        "abs-dataflows",
        "abs-data",
        "cnra-dataset-search",
        "bps-domain-list",
        "estat-stats-list",
        "estat-stats-data",
        "materials-summary-search",
        "india-resource-get",
        "brazil-dataset-list",
        "asu-dataverse-search",
        "asu-oai-identify",
        "uk-api-catalogue-index",
        "poland-isztar4-service-info",
        "ukraine-nipo-statistics",
        "korea-krx-listed-companies"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "collection_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "include_dataset_metadata": {
          "type": "boolean"
        },
        "dataflow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "data_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "last_n_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "domain_type": {
          "type": "string",
          "enum": [
            "all",
            "prov",
            "kab",
            "kabbyprov"
          ]
        },
        "province_code": {
          "type": "string",
          "pattern": "^[0-9]{2,4}$"
        },
        "stats_data_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "chemical_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "resource_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "base_date": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "company_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "classification": {
          "const": "public"
        },
        "contains_personal_data": {
          "const": false
        }
      },
      "required": [
        "classification",
        "contains_personal_data"
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 90
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        }
      }
    }
  },
  "required": [
    "task_id",
    "provider",
    "operation",
    "objective",
    "parameters",
    "data_policy",
    "acceptance"
  ]
}
