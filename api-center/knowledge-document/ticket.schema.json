{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/evidence-data-center/api-center/knowledge-document/ticket.schema.json",
  "title": "WolframAlpha or LlamaParse managed API ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "provider",
    "operation",
    "objective",
    "parameters",
    "data_policy",
    "acceptance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "wolframalpha",
        "llamaparse"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "llm-query",
        "full-results-json",
        "short-answer",
        "query-recognizer",
        "create-parse-job",
        "list-parse-jobs",
        "get-parse-result"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "parameters": {
      "type": "object"
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "contains_personal_data"
      ],
      "properties": {
        "classification": {
          "const": "public"
        },
        "contains_personal_data": {
          "const": false
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_response_bytes"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 90
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "wolframalpha"
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "catalog-capabilities",
              "llm-query",
              "full-results-json",
              "short-answer",
              "query-recognizer"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "llamaparse"
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "enum": [
              "catalog-capabilities",
              "create-parse-job",
              "list-parse-jobs",
              "get-parse-result"
            ]
          }
        }
      }
    }
  ]
}
