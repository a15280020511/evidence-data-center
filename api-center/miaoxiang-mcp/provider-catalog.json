  "providers": [
    {
      "provider_id": "miaoxiang-mcp",
      "display_name": "东方财富妙想 MCP",
      "description": "通过东方财富官方 Streamable HTTP MCP Server 读取 A股、港股、美股、基金、债券、指数板块、宏观经济、公告研报和证券筛选数据。",
      "enabled": true,
      "ticket_prefix": "[api-mx-mcp]",
      "required_secret_environment_variable": "EM_API_KEY",
      "catalog_policy": "仅开放 MCP 上游实际发现并经仓库固定登记的 11 个只读工具，以及本地目录和 tools/list；禁止任意 JSON-RPC 方法、任意工具名和动态端点。",
      "execution_policy": "每张票据只执行一个固定只读工具调用；后端通过 em_api_key 请求头注入 EM_API_KEY；禁止自选股修改、模拟交易、下单、账户操作和其他写操作。",
      "official_origin": "https://mxapi.eastmoney.com",
      "official_endpoint": "https://mxapi.eastmoney.com/mxds/mcp",
      "mcp_server_name": "mx-ds-mcp",
      "mcp_server_version": "1.0.0",
      "mcp_transport": "StreamableHttp",
      "mcp_protocol_version": "2025-11-25",
      "authentication_header": "em_api_key",
