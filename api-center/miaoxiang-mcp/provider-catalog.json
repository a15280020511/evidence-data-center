        },
        {
          "operation_id": "us-finance-data",
          "description": "基于东方财富数据库，支持自然语言查询美股金融数据，覆盖美股证券与公司基本资料、股本与股东结构、行情与技术指标、量化风险指标、财务三表与估值盈利预测，以及IPO/回购/分红等，单次请求最多支持500只股票，可发起多次请求。例如：苹果和特斯拉近10个交易日的涨跌幅、换手率",
          "parameters": ["query"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {"query": {"type": "string", "minLength": 1, "maxLength": 500}},
            "required": ["query"]
          },
          "mcp_tool_name": "mx_us_finance_data",
          "execution": {"local": false, "jsonrpc_method": "tools/call", "mcp_tool_name": "mx_us_finance_data"},
          "result_contract": {"provider": "miaoxiang-mcp", "official_endpoint": "https://mxapi.eastmoney.com/mxds/mcp", "read_only": true, "credential_mode": "em_api_key_backend_only"}
