{
  "schema_version": "information-tool-radar-config-v2",
  "mode": "bounded-read-only",
  "timeout_seconds": 18,
  "max_response_bytes": 1500000,
  "max_records_per_probe": 10,
  "minimum_required_adapter_success_rate": 0.85,
  "minimum_category_coverage": 0.85,
  "adapters": {
    "common_crawl": {
      "enabled": true,
      "required_for_gate": true,
      "category": "present_web",
      "index_catalog": "https://index.commoncrawl.org/collinfo.json",
      "probe_domains": [
        "openalex.org",
        "datacite.org",
        "modelcontextprotocol.io",
        "flk.npc.gov.cn",
        "court.gov.cn",
        "spp.gov.cn",
        "mps.gov.cn",
        "ccdi.gov.cn"
      ]
    },
    "wayback": {
      "enabled": true,
      "required_for_gate": true,
      "category": "historical_web",
      "endpoint": "https://web.archive.org/cdx/search/cdx",
      "fallback_endpoint": "https://arquivo.pt/wayback/cdx",
      "probe_domains": [
        "openalex.org",
        "datacite.org",
        "modelcontextprotocol.io",
        "flk.npc.gov.cn",
        "court.gov.cn",
        "spp.gov.cn",
        "mps.gov.cn",
        "ccdi.gov.cn"
      ]
    },
    "gdelt": {
      "enabled": true,
      "required_for_gate": false,
      "category": "global_events",
      "endpoint": "https://api.gdeltproject.org/api/v2/doc/doc",
      "fallback_feed": "https://data.gdeltproject.org/gdeltv3/web/ngrams/LASTUPDATE.TXT",
      "queries": [
        "artificial intelligence",
        "最高人民法院",
        "最高人民检察院",
        "公安部 司法",
        "中央纪委国家监委",
        "司法部 行政复议",
        "中国政法",
        "中国海警 执法",
        "国家移民管理局 典型案例"
      ]
    },
    "reliefweb": {
      "enabled": true,
      "required_for_gate": true,
      "category": "global_events",
      "endpoint": "https://api.reliefweb.int/v2/disasters",
      "appname": "evidence-data-center"
    },
    "wikimedia": {
      "enabled": true,
      "required_for_gate": true,
      "category": "multilingual_entities",
      "request_delay_seconds": 0.4,
      "maxlag": 5,
      "languages": [
        "en",
        "zh",
        "ja",
        "ko",
        "fr",
        "es",
        "de",
        "pt",
        "ru",
        "ar",
        "hi",
        "id"
      ]
    },
    "datacite": {
      "enabled": true,
      "required_for_gate": false,
      "category": "research_data",
      "endpoint": "https://api.datacite.org/dois",
      "queries": [
        "causal inference",
        "remote sensing",
        "public procurement",
        "agent based modeling",
        "China criminal justice",
        "China electronic evidence",
        "China procuratorial system",
        "China supervision law",
        "China forensic science"
      ],
      "fallback_parameters": {
        "resource-type-id": "dataset",
        "sort": "-updated"
      }
    },
    "crossref": {
      "enabled": true,
      "required_for_gate": true,
      "category": "research_data",
      "endpoint": "https://api.crossref.org/works",
      "queries": [
        "causal inference",
        "remote sensing",
        "agent based modeling",
        "China criminal procedure",
        "China policing electronic evidence",
        "China procuratorial reform",
        "China discipline inspection supervision",
        "China forensic science standards",
        "China judicial reform"
      ]
    },
    "pypi": {
      "enabled": true,
      "required_for_gate": true,
      "category": "software_packages",
      "rss": "https://pypi.org/rss/updates.xml"
    },
    "osv": {
      "enabled": true,
      "required_for_gate": true,
      "category": "software_security",
      "endpoint": "https://api.osv.dev/v1/querybatch",
      "packages": [
        {"ecosystem": "PyPI", "name": "requests"},
        {"ecosystem": "PyPI", "name": "numpy"},
        {"ecosystem": "npm", "name": "axios"}
      ]
    },
    "github": {
      "enabled": true,
      "required_for_gate": true,
      "category": "code_tools",
      "endpoint": "https://api.github.com/search/repositories",
      "queries": [
        "MCP search",
        "PDF table extraction OCR",
        "entity resolution",
        "causal inference",
        "agent based modeling",
        "open data Africa",
        "China legal data API",
        "legal research MCP",
        "court case data MCP",
        "forensic evidence open source"
      ]
    }
  },
  "coverage_dimensions": [
    "present_web",
    "historical_web",
    "global_events",
    "multilingual_entities",
    "research_data",
    "software_packages",
    "software_security",
    "code_tools"
  ],
  "forbidden_actions": [
    "install discovered package",
    "execute discovered code",
    "start local MCP server",
    "run unknown container or binary",
    "submit credentials",
    "activate billing",
    "write to external services",
    "bypass robots access control or paywall",
    "retrieve copyrighted content",
    "resolve direct download links",
    "bypass captcha or anti-bot protection"
  ]
}
