{
  "schema_version": "imf-provider-catalog-v1",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "imf",
      "display_name": "IMF DataMapper 宏观经济与财政统计",
      "description": "通过 IMF 官方 DataMapper API v2 读取指标、国家、地区、分组和宏观时间序列。",
      "enabled": true,
      "ticket_prefix": "[intel-imf]",
      "required_secret_environment_variable": "",
      "catalog_policy": "固定访问 IMF DataMapper API v2，不需要密钥。",
      "execution_policy": "每张票据最多一次 GET；无重试、无自动翻页；最多20个地点、50个时期。",
      "official_documentation": "https://www.imf.org/external/datamapper/api/help",
      "official_origin": "https://www.imf.org/external/datamapper/api/v2",
      "limits": {
        "requests_per_ticket_max": 1,
        "transient_retry_max": 0,
        "provider_concurrency_max": 1,
        "timeout_seconds_max": 60,
        "max_response_bytes": 20000000,
        "locations_per_ticket_max": 20,
        "periods_per_ticket_max": 50,
        "fixed_api_host": "www.imf.org",
        "fixed_api_prefix": "/external/datamapper/api/v2",
        "automatic_retry_allowed": false,
        "automatic_pagination_allowed": false,
        "bulk_download_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_hosts_allowed": false,
        "arbitrary_headers_allowed": false,
        "write_operations_allowed": false,
        "secret_values_exposed": false,
        "authentication_required": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地 IMF 能力目录。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "imf",
            "http_method": "LOCAL",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "list-indicators",
          "description": "读取 IMF 指标目录。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "imf",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "list-countries",
          "description": "读取国家目录。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "imf",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "list-regions",
          "description": "读取地区目录。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "imf",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "list-groups",
          "description": "读取经济体分组目录。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "imf",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "get-series",
          "description": "读取一个指标、最多20个地点和50个时期的序列。",
          "parameters": [
            "indicator",
            "locations",
            "periods"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "indicator": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,79}$"
              },
              "locations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,79}$"
                }
              },
              "periods": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{4}(?:-(?:M[0-9]{2}|Q[1-4]))?$"
                }
              }
            },
            "required": [
              "indicator",
              "locations"
            ]
          },
          "result_contract": {
            "provider": "imf",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "none"
          }
        }
      ]
    }
  ]
}
