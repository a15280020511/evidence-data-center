{
  "schema_version": "consensus-mcp-provider-catalog-v1",
  "secret_values_exposed": false,
  "official_documentation": "https://docs.consensus.app/docs/mcp",
  "providers": [
    {
      "provider_id": "consensus-mcp",
      "display_name": "Consensus MCP",
      "description": "通过 Consensus 官方 Streamable HTTP MCP Server 检索 2 亿+ 同行评审学术论文。默认使用无需账号的匿名免费模式；不抓取 Consensus 网页。",
      "enabled": true,
      "ticket_prefix": "[api-consensus-mcp]",
      "required_secret_environment_variable": null,
      "optional_secret_environment_variable": "CONSENSUS_MCP_BEARER_TOKEN",
      "catalog_policy": "仅开放官方 MCP 上游实际发现并经仓库固定登记的只读 search 工具，以及本地能力目录和 tools/list；禁止任意 JSON-RPC 方法、任意工具名、网页抓取和付费 API 自动启用。",
      "execution_policy": "每张票据只执行一个固定只读工具调用；默认匿名免费访问。仅当仓库显式配置 CONSENSUS_MCP_BEARER_TOKEN 时才注入 Authorization: Bearer，且不得记录凭证。",
      "official_origin": "https://mcp.consensus.app",
      "official_endpoint": "https://mcp.consensus.app/mcp",
      "mcp_transport": "StreamableHttp",
      "authentication": {
        "default_mode": "anonymous-free",
        "account_oauth_mode": "interactive-client-only-not-github-actions",
        "bearer_mode": "optional-enterprise-or-api-key-only",
        "free_account_note": "Free account OAuth yields 10 papers/search and 30 MCP searches/month in supported interactive MCP clients; GitHub Actions defaults to anonymous because OAuth is interactive.",
        "anonymous_limits": {
          "papers_per_search": 3,
          "monthly_searches": "unlimited"
        },
        "free_account_limits": {
          "papers_per_search": 10,
          "monthly_searches": 30
        }
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地 Consensus MCP 安全能力目录，不访问上游。",
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "execution": {"local": true, "jsonrpc_method": null, "mcp_tool_name": null}
        },
        {
          "operation_id": "mcp-tools-list",
          "description": "通过 MCP initialize 和 tools/list 验证官方服务器及当前只读工具目录。",
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "execution": {"local": false, "jsonrpc_method": "tools/list", "mcp_tool_name": null}
        },
        {
          "operation_id": "search",
          "description": "检索 Consensus 同行评审论文索引。支持年份、研究类型、期刊质量、人类研究、样本量、医学模式、排除预印本和研究时长过滤。",
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": {
              "query": {"type": "string", "minLength": 1, "maxLength": 800},
              "year_min": {"type": "integer", "minimum": 1600, "maximum": 2100},
              "year_max": {"type": "integer", "minimum": 1600, "maximum": 2100},
              "study_types": {
                "type": "array",
                "maxItems": 8,
                "items": {"enum": ["rct", "meta-analysis", "systematic review", "literature review", "case report", "non-rct experimental", "non-rct observational study", "non-rct in vitro", "animal"]}
              },
              "sjr_max": {"type": "integer", "minimum": 1, "maximum": 4},
              "human": {"type": "boolean"},
              "sample_size_min": {"type": "integer", "minimum": 1, "maximum": 1000000000},
              "medical_mode": {"type": "boolean"},
              "exclude_preprints": {"type": "boolean"},
              "duration_min": {"type": "integer", "minimum": 0, "maximum": 100000},
              "duration_max": {"type": "integer", "minimum": 0, "maximum": 100000}
            }
          },
          "execution": {"local": false, "jsonrpc_method": "tools/call", "mcp_tool_name": "search"}
        }
      ],
      "limits": {
        "fixed_mcp_tool_count": 1,
        "arbitrary_jsonrpc_methods_allowed": false,
        "arbitrary_mcp_tool_names_allowed": false,
        "write_operations_allowed": false,
        "web_scraping_allowed": false,
        "paid_api_auto_enable_allowed": false,
        "default_timeout_seconds": 30,
        "max_timeout_seconds": 90,
        "max_response_bytes": 2000000
      }
    }
  ]
}
