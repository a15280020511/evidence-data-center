          "execution": {
            "local": false,
            "path_template": "/v2/ai_search/web_search",
            "http_method": "POST",
            "credential_mode": "unified-api-key-bearer",
            "content_type": "application/json",
            "official_origin": "https://qianfan.baidubce.com"
          },
