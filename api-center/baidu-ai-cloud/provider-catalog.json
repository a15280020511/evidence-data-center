      "enabled": true,
      "ticket_prefix": "[intel-baidu-ai]",
      "required_secret_environment_variable": "BAIDU_AI_CLOUD_API_KEY",
      "required_secret_environment_variables": [
        "BAIDU_AI_CLOUD_API_KEY"
      ],
      "credential_matrix": {
        "web-search": [
          "BAIDU_AI_CLOUD_API_KEY"
        ],
        "web-summary": [
          "BAIDU_AI_CLOUD_API_KEY"
        ],
        "baike-lemma-list": [
          "BAIDU_AI_CLOUD_API_KEY"
