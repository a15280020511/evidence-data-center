{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-system.example/schemas/professional-open-apis-ticket-v1.json",
  "title": "Professional Open APIs Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "provider", "operation", "objective", "parameters", "data_policy", "acceptance"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,119}$"},
    "provider": {"const": "professional-open-apis"},
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "source-access-matrix",
        "data-gov-uk-search",
        "pubchem-compound-properties",
        "usgs-water-instantaneous",
        "worms-taxon-search",
        "idref-authority-search",
        "sudoc-isbn-lookup",
        "ons-datasets",
        "agris-ods-index"
      ]
    },
    "objective": {"type": "string", "minLength": 3, "maxLength": 1000},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 200},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "properties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "MolecularFormula",
              "MolecularWeight",
              "CanonicalSMILES",
              "IsomericSMILES",
              "InChI",
              "InChIKey",
              "XLogP",
              "TPSA",
              "Complexity",
              "HBondDonorCount",
              "HBondAcceptorCount",
              "RotatableBondCount",
              "ExactMass",
              "MonoisotopicMass",
              "Charge",
              "HeavyAtomCount"
            ]
          }
        },
        "site": {"type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[A-Za-z0-9_-]+$"},
        "parameter_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\d{5}$"}
        },
        "period": {"type": "string", "enum": ["PT1H", "PT6H", "P1D", "P7D", "P30D"]},
        "like": {"type": "boolean"},
        "marine_only": {"type": "boolean"},
        "index": {
          "type": "string",
          "enum": ["all", "persname_t", "corpname_t", "subjectheading_t", "geogname_t", "famname_t", "uniformtitle_t", "trademark_t"]
        },
        "isbn": {"type": "string", "minLength": 10, "maxLength": 32}
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {
        "classification": {"const": "public"},
        "contains_personal_data": {"const": false},
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 90},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 10000000}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"enum": ["data-gov-uk-search", "idref-authority-search"]}}},
      "then": {"properties": {"parameters": {"required": ["query"]}}}
    },
    {
      "if": {"properties": {"operation": {"enum": ["pubchem-compound-properties", "worms-taxon-search"]}}},
      "then": {"properties": {"parameters": {"required": ["name"]}}}
    },
    {
      "if": {"properties": {"operation": {"const": "usgs-water-instantaneous"}}},
      "then": {"properties": {"parameters": {"required": ["site"]}}}
    },
    {
      "if": {"properties": {"operation": {"const": "sudoc-isbn-lookup"}}},
      "then": {"properties": {"parameters": {"required": ["isbn"]}}}
    },
    {
      "if": {"properties": {"operation": {"enum": ["catalog-capabilities", "source-access-matrix", "agris-ods-index"]}}},
      "then": {"properties": {"parameters": {"maxProperties": 0}}}
    }
  ]
}
