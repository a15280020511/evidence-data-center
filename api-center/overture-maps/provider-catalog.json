{
  "schema_version": "overture-maps-provider-catalog-v1",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "overture-maps",
      "display_name": "Overture Maps 全球开放地图数据",
      "description": "通过 Overture 官方 STAC 目录和匿名对象存储，以受限边界框读取全球地址、建筑、行政区、地点、交通与基础底图要素。",
      "enabled": true,
      "ticket_prefix": "[api-overture]",
      "required_secret_environment_variable": "",
      "catalog_policy": "开放固定发布目录、要素类型、计数、城市级边界框提取和 GERS 查询；不开放全量全球下载、任意对象存储路径或任意 URL。",
      "execution_policy": "只调用 Overture 官方 Python 客户端固定只读函数；边界框面积、要素类型、发布格式、返回条数和响应体积均受硬限制。",
      "limits": {
        "requests_per_ticket_max": 1,
        "timeout_seconds_max": 120,
        "max_response_bytes": 20000000,
        "arbitrary_urls_allowed": false,
        "arbitrary_hosts_allowed": false,
        "arbitrary_paths_allowed": false,
        "arbitrary_headers_allowed": false,
        "redirects_allowed": false,
        "write_operations_allowed": false,
        "personal_data_allowed": false,
        "secret_values_exposed": false,
        "fixed_api_hosts": [
          "stac.overturemaps.org",
          "overturemaps-us-west-2.s3.us-west-2.amazonaws.com"
        ],
        "bbox_area_square_degrees_max": 4.0,
        "features_per_ticket_max": 1000,
        "anonymous_object_storage_only": true,
        "whole_world_download_allowed": false,
        "arbitrary_s3_paths_allowed": false,
        "arbitrary_feature_types_allowed": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地 Overture Maps 安全能力目录，不访问上游.",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "overture-maps",
            "official_origin": "https://stac.overturemaps.org",
            "http_method": "LOCAL",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "list-feature-types",
          "description": "读取固定开放的 Overture 主题与要素类型清单，不访问上游.",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "overture-maps",
            "official_origin": "local-allowlist",
            "http_method": "LOCAL",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "list-releases",
          "description": "读取 Overture STAC 目录中的当前可用发布版本.",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "overture-maps",
            "official_origin": "https://stac.overturemaps.org",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "anonymous"
          }
        },
        {
          "operation_id": "latest-release",
          "description": "读取 Overture STAC 目录标记的最新发布版本.",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "overture-maps",
            "official_origin": "https://stac.overturemaps.org",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "anonymous"
          }
        },
        {
          "operation_id": "count-features",
          "description": "按城市级经纬度边界框统计指定 Overture 要素类型数量.",
          "parameters": [
            "feature_type",
            "bbox",
            "release"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "feature_type": {
                "type": "string",
                "enum": [
                  "address",
                  "bathymetry",
                  "building",
                  "building_part",
                  "division",
                  "division_area",
                  "division_boundary",
                  "place",
                  "segment",
                  "connector",
                  "infrastructure",
                  "land",
                  "land_cover",
                  "land_use",
                  "water"
                ]
              },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "release": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
              }
            },
            "required": [
              "feature_type",
              "bbox"
            ]
          },
          "result_contract": {
            "provider": "overture-maps",
            "official_origin": "anonymous Overture S3 + STAC",
            "http_method": "READ",
            "read_only": true,
            "credential_mode": "anonymous"
          }
        },
        {
          "operation_id": "query-features",
          "description": "按城市级边界框提取指定类型的有限条 GeoJSON 要素.",
          "parameters": [
            "feature_type",
            "bbox",
            "release",
            "limit"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "feature_type": {
                "type": "string",
                "enum": [
                  "address",
                  "bathymetry",
                  "building",
                  "building_part",
                  "division",
                  "division_area",
                  "division_boundary",
                  "place",
                  "segment",
                  "connector",
                  "infrastructure",
                  "land",
                  "land_cover",
                  "land_use",
                  "water"
                ]
              },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "release": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            },
            "required": [
              "feature_type",
              "bbox"
            ]
          },
          "result_contract": {
            "provider": "overture-maps",
            "official_origin": "anonymous Overture S3 + STAC",
            "http_method": "READ",
            "read_only": true,
            "credential_mode": "anonymous",
            "artifact": "features.geojson"
          }
        },
        {
          "operation_id": "lookup-gers",
          "description": "按固定 UUID 格式查询 Overture Global Entity Reference System 注册表.",
          "parameters": [
            "gers_id"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gers_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "gers_id"
            ]
          },
          "result_contract": {
            "provider": "overture-maps",
            "official_origin": "anonymous Overture S3 + STAC",
            "http_method": "READ",
            "read_only": true,
            "credential_mode": "anonymous"
          }
        }
      ]
    }
  ]
}
