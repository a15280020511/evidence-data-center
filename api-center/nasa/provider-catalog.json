{
  "schema_version": "nasa-provider-catalog-v1",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [
    "nasa-earth-api",
    "nasa-mars-rover-photos-api"
  ],
  "providers": [
    {
      "provider_id": "nasa",
      "display_name": "NASA Open APIs 与 Earthdata GIBS",
      "description": "通过 NASA 官方固定只读端点读取天文图片、近地小行星、空间天气、EPIC 地球影像元数据、NASA 图像资料库以及 Earthdata GIBS 地球观测图层和单瓦片影像。",
      "enabled": true,
      "ticket_prefix": "[intel-nasa]",
      "required_secret_environment_variable": "NASA_API_KEY",
      "catalog_policy": "只开放25项固定只读操作；旧 Earth API 与 Mars Rover Photos API 已归档且不开放；禁止任意URL、任意主机、任意路径、批量影像下载、后台轮询、上传和写入。",
      "execution_policy": "每张票据最多一次上游GET且不自动重试；api.nasa.gov操作由后端注入NASA_API_KEY；NASA Image Library和GIBS免密；所有响应受字节上限约束。",
      "official_documentation": "https://api.nasa.gov/",
      "official_origins": [
        "https://api.nasa.gov",
        "https://images-api.nasa.gov",
        "https://gibs.earthdata.nasa.gov"
      ],
      "service_status_notice": "NASA Open APIs官方页面已标明旧Earth API和Mars Rover Photos API归档；地球影像使用Earthdata GIBS替代。默认开发者密钥额度通常为每小时1000次，实际以响应头和账户状态为准。",
      "limits": {
        "requests_per_ticket_max": 1,
        "transient_retry_max": 0,
        "provider_concurrency_max": 1,
        "timeout_seconds_max": 60,
        "max_response_bytes": 10000000,
        "apod_date_span_days_max": 31,
        "apod_random_count_max": 10,
        "neo_feed_span_days_max": 7,
        "donki_date_span_days_max": 31,
        "nasa_images_page_max": 100,
        "gibs_tiles_per_ticket_max": 1,
        "fixed_hosts": [
          "api.nasa.gov",
          "images-api.nasa.gov",
          "gibs.earthdata.nasa.gov"
        ],
        "automatic_pagination_allowed": false,
        "bulk_download_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_hosts_allowed": false,
        "arbitrary_paths_allowed": false,
        "arbitrary_headers_allowed": false,
        "client_supplied_credentials_allowed": false,
        "background_polling_allowed": false,
        "archived_earth_api_allowed": false,
        "archived_mars_rover_api_allowed": false,
        "write_operations_allowed": false,
        "secret_values_exposed": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地 NASA 安全能力目录，不访问上游.",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "nasa",
            "http_method": "LOCAL",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "apod",
          "description": "读取 NASA Astronomy Picture of the Day 单日、有限日期范围或有限随机结果.",
          "parameters": [
            "date",
            "start_date",
            "end_date",
            "count",
            "thumbs"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "start_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "end_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "thumbs": {
                "type": "boolean"
              }
            }
          },
          "result_contract": {
            "host": "api.nasa.gov",
            "path": "/planetary/apod",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "api_key_query_backend_only"
          }
        },
