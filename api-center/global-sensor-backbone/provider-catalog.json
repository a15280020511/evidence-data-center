{
  "schema_version": "global-sensor-backbone-provider-catalog-v1",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "global-sensor-backbone",
      "display_name": "全球现实传感器主干",
      "description": "统一读取全球气象水文通知、洪水、互联网探针、网络干扰、能源基础设施、港口船舶、卫星产品、食品价格和电力系统高频观测。",
      "enabled": true,
      "ticket_prefix": "[intel-global-sensor]",
      "required_secret_environment_variable": "",
      "optional_secret_environment_variables": [],
      "catalog_policy": "仅允许固定官方或公益主机、固定只读操作、单次请求或最长30秒WIS2订阅；禁止任意URL、个人跟踪、自动分页、持续流、设备控制和写入。",
      "execution_policy": "每张票据最多一次上游访问；密钥仅后端注入；无密钥操作可直接运行；需要密钥的操作缺失配置时结构化失败。",
      "official_origin": "multiple-fixed-public-institutional-origins",
      "limits": {
        "requests_per_ticket_max": 1,
        "timeout_seconds_max": 120,
        "max_response_bytes": 20000000,
        "provider_concurrency_max": 1,
        "automatic_retry_allowed": false,
        "automatic_pagination_allowed": false,
        "redirects_allowed": false,
        "arbitrary_urls_allowed": false,
        "write_operations_allowed": false,
        "individual_tracking_allowed": false,
        "wis2_subscription_seconds_max": 30,
        "secret_values_exposed": false,
        "noncommercial_only_operations": [],
        "development_only_until_production_approval": []
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地全球传感器能力目录。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "global-sensor-backbone",
            "official_origin": "",
            "http_method": "LOCAL",
            "read_only": true,
            "credential_mode": "none"
          }
        },
