              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "start": {
                "type": "string",
                "maxLength": 16
              },
              "end": {
                "type": "string",
                "maxLength": 16
              },
              "community": {
                "enum": [
                  "RE",
                  "AG",
                  "SB"
                ]
              },
              "format": {
                "enum": [
                  "JSON",
                  "CSV"
                ]
              }
            }
