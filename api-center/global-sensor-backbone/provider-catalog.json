            "properties": {
              "temporal": {
                "enum": [
                  "hourly",
                  "daily",
                  "monthly",
                  "climatology"
                ]
              },
              "parameters": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
