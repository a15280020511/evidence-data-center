        {
          "operation_id": "wis2-notifications",
          "description": "短时订阅WMO WIS2全球Broker通知。",
          "parameters": [
            "broker",
            "topic",
            "max_messages"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "broker": {
                "enum": [
                  "noaa",
                  "meteofrance",
                  "cma",
                  "inmet"
                ]
              },
              "topic": {
                "type": "string",
                "maxLength": 500
              },
              "max_messages": {
                "type": "integer",
                "minimum": 1,
                "maximum": 25
              }
            }
          },
          "result_contract": {
            "provider": "global-sensor-backbone",
            "official_origin": "mqtts://WMO-WIS2-global-brokers:8883",
            "http_method": "MQTTS",
            "read_only": true,
            "credential_mode": "public-everyone"
          }
        },
