{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Sensor Backbone Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "provider", "operation", "objective", "parameters", "data_policy", "acceptance"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "provider": {"const": "global-sensor-backbone"},
    "operation": {
      "enum": [
        "catalog-capabilities", "source-status", "wis2-notifications", "glofas-collection",
        "ripe-atlas-probes", "ripe-atlas-measurements", "ripe-atlas-results",
        "ooni-measurements", "ooni-aggregation", "nasa-power-point",
        "eumetsat-collections", "portwatch-collections", "portwatch-items",
        "open-prices", "gfw-events", "entsog-operational-data", "gie-storage",
        "kpx-current-supply", "kpx-generation-mix", "aemo-nemweb-index",
        "ecmwf-open-data-index"
      ]
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 3000},
    "parameters": {"type": "object", "maxProperties": 16, "additionalProperties": true},
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {
        "classification": {"const": "public"},
        "contains_personal_data": {"const": false},
        "notes": {"type": "string", "maxLength": 2000}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 120},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 20000000}
      }
    }
  }
}
