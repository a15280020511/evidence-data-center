{
  "id": "tianditu-place-search",
  "enabled": true,
  "endpoint": "/data/tianditu/place/search",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "15s",
  "input_query_strings": [
    "postStr",
    "type"
  ],
  "secret_query": {
    "name": "tk",
    "env": "TIANDITU_API_KEY"
  },
  "response_contract": {
    "status_path": "status.infocode",
    "success_values": [
      1000
    ],
    "error_code_path": "status.infocode",
    "message_path": "status.cndesc",
    "any_data_paths": [
      "pois",
      "statistics",
      "area",
      "lineData",
      "prompt"
    ]
  },
  "backend": {
    "host": "https://api.tianditu.gov.cn",
    "url_pattern": "/v2/search",
    "method": "GET",
    "encoding": "json",
    "allow": [
      "resultType",
      "count",
      "keyword",
      "pois",
      "statistics",
      "priorityCitys",
      "allAdmins",
      "area",
      "lineData",
      "prompt",
      "status"
    ],
    "resilience": {
      "rate_limit": {
        "max_rate": 1,
        "every": "1s",
        "capacity": 1
      }
    }
  }
}
