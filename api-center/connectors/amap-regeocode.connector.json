{
  "id": "amap-regeocode",
  "enabled": true,
  "endpoint": "/data/amap/regeocode",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "5s",
  "input_query_strings": ["location", "poitype", "radius", "extensions", "roadlevel", "homeorcorp"],
  "secret_query": {"name": "key", "env": "AMAP_API_KEY"},
  "response_contract": {
    "status_path": "status",
    "success_values": ["1"],
    "error_code_path": "infocode",
    "message_path": "info",
    "any_data_paths": ["regeocode"]
  },
  "backend": {
    "host": "https://restapi.amap.com",
    "url_pattern": "/v3/geocode/regeo",
    "method": "GET",
    "encoding": "json",
    "allow": ["status", "info", "infocode", "regeocode"]
  }
}
