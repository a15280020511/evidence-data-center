{
  "backend": {
    "allow": [
      "@context",
      "id",
      "type",
      "geometry",
      "properties",
      "features",
      "pagination",
      "title",
      "status",
      "detail",
      "instance",
      "correlationId"
    ],
    "encoding": "json",
    "host": "https://api.weather.gov",
    "method": "GET",
    "resilience": {
      "circuit_breaker": {
        "interval": 60,
        "log_status_change": true,
        "max_errors": 3,
        "timeout": 20
      },
      "rate_limit": {
        "capacity": 2,
        "every": "1s",
        "max_rate": 2
      }
    },
    "url_pattern": "/points/{latitude},{longitude}"
  },
  "enabled": true,
  "endpoint": "/data/noaa/nws/points/{latitude},{longitude}",
  "id": "noaa-nws-points",
  "method": "GET",
  "output_encoding": "json",
  "path_parameters": {
    "latitude": {
      "max_length": 10,
      "pattern": "^-?[0-9]{1,2}(?:\\.[0-9]{1,6})?$"
    },
    "longitude": {
      "max_length": 11,
      "pattern": "^-?[0-9]{1,3}(?:\\.[0-9]{1,6})?$"
    }
  },
  "response_contract": {
    "any_data_paths": [
      "properties"
    ],
    "success_when_data_present": true
  },
  "timeout": "20s"
}
