{
  "backend": {
    "allow": [
      "@context",
      "id",
      "type",
      "geometry",
      "properties",
      "features",
      "pagination",
      "title",
      "status",
      "detail",
      "instance",
      "correlationId"
    ],
    "encoding": "json",
    "host": "https://api.weather.gov",
    "method": "GET",
    "resilience": {
      "circuit_breaker": {
        "interval": 60,
        "log_status_change": true,
        "max_errors": 3,
        "timeout": 20
      },
      "rate_limit": {
        "capacity": 2,
        "every": "1s",
        "max_rate": 2
      }
    },
    "url_pattern": "/gridpoints/{office}/{grid_x},{grid_y}/stations"
  },
  "enabled": true,
  "endpoint": "/data/noaa/nws/gridpoints/{office}/{grid_x}/{grid_y}/stations",
  "id": "noaa-nws-gridpoint-stations",
  "input_query_strings": [
    "limit",
    "cursor"
  ],
  "method": "GET",
  "output_encoding": "json",
  "parameter_rules": {
    "properties": {
      "cursor": {
        "max_length": 256,
        "type": "string"
      },
      "limit": {
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    }
  },
  "path_parameters": {
    "grid_x": {
      "max_length": 3,
      "pattern": "^[0-9]{1,3}$"
    },
    "grid_y": {
      "max_length": 3,
      "pattern": "^[0-9]{1,3}$"
    },
    "office": {
      "max_length": 3,
      "pattern": "^[A-Z]{3}$"
    }
  },
  "response_contract": {
    "any_data_paths": [
      "features"
    ],
    "success_when_data_present": true
  },
  "timeout": "20s"
}
