{
  "id": "amap-ip-location",
  "enabled": true,
  "endpoint": "/data/amap/ip/location",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "12s",
  "input_query_strings": [
    "ip"
  ],
  "secret_query": {
    "name": "key",
    "env": "AMAP_API_KEY"
  },
  "response_contract": {
    "status_path": "status",
    "success_values": [
      "1"
    ],
    "error_code_path": "infocode",
    "message_path": "info",
    "any_data_paths": [
      "province",
      "city",
      "adcode",
      "rectangle"
    ]
  },
  "backend": {
    "host": "https://restapi.amap.com",
    "url_pattern": "/v3/ip",
    "method": "GET",
    "encoding": "json",
    "allow": [
      "status",
      "info",
      "infocode",
      "count",
      "province",
      "city",
      "adcode",
      "rectangle"
    ],
    "resilience": {
      "rate_limit": {
        "max_rate": 5,
        "every": "1s",
        "capacity": 5
      }
    }
  },
  "parameter_rules": {
    "properties": {
      "ip": {
        "type": "string",
        "min_length": 3,
        "max_length": 64
      }
    }
  }
}
