{
  "backend": {
    "allow": [
      "@context",
      "id",
      "type",
      "geometry",
      "properties",
      "features",
      "pagination",
      "title",
      "status",
      "detail",
      "instance",
      "correlationId"
    ],
    "encoding": "json",
    "host": "https://api.weather.gov",
    "method": "GET",
    "resilience": {
      "circuit_breaker": {
        "interval": 60,
        "log_status_change": true,
        "max_errors": 3,
        "timeout": 20
      },
      "rate_limit": {
        "capacity": 2,
        "every": "1s",
        "max_rate": 2
      }
    },
    "url_pattern": "/stations/{station_id}/observations/latest"
  },
  "enabled": true,
  "endpoint": "/data/noaa/nws/stations/{station_id}/observations/latest",
  "id": "noaa-nws-station-latest",
  "input_query_strings": [
    "require_qc"
  ],
  "method": "GET",
  "output_encoding": "json",
  "parameter_rules": {
    "properties": {
      "require_qc": {
        "type": "boolean"
      }
    }
  },
  "path_parameters": {
    "station_id": {
      "max_length": 16,
      "pattern": "^[A-Z0-9-]{3,16}$"
    }
  },
  "response_contract": {
    "any_data_paths": [
      "properties"
    ],
    "success_when_data_present": true
  },
  "timeout": "20s"
}
