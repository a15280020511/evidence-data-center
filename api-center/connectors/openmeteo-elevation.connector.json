{
  "id": "openmeteo-elevation",
  "enabled": true,
  "endpoint": "/data/openmeteo/elevation",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "25s",
  "input_query_strings": [
    "latitude",
    "longitude"
  ],
  "response_contract": {
    "success_when_data_present": true,
    "any_data_paths": [
      "elevation"
    ]
  },
  "backend": {
    "host": "https://api.open-meteo.com",
    "url_pattern": "/v1/elevation",
    "method": "GET",
    "encoding": "json",
    "allow": [
      "latitude",
      "longitude",
      "generationtime_ms",
      "utc_offset_seconds",
      "timezone",
      "timezone_abbreviation",
      "elevation",
      "current_units",
      "current",
      "hourly_units",
      "hourly",
      "daily_units",
      "daily",
      "results",
      "reason",
      "error"
    ],
    "resilience": {
      "rate_limit": {
        "max_rate": 5,
        "every": "1s",
        "capacity": 5
      }
    }
  },
  "parameter_rules": {
    "properties": {
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      }
    },
    "required_any_of": [
      [
        "latitude"
      ],
      [
        "longitude"
      ]
    ]
  }
}
