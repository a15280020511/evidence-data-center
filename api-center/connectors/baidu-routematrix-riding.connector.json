{
  "id": "baidu-routematrix-riding",
  "enabled": true,
  "endpoint": "/data/baidu/routematrix/riding",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "15s",
  "input_query_strings": [
    "origins",
    "destinations",
    "tactics",
    "coord_type",
    "ret_coordtype"
  ],
  "secret_query": {
    "name": "ak",
    "env": "BAIDU_MAP_API_KEY"
  },
  "response_contract": {
    "status_path": "status",
    "success_values": [
      0
    ],
    "message_path": "message",
    "any_data_paths": [
      "result"
    ]
  },
  "backend": {
    "host": "https://api.map.baidu.com",
    "url_pattern": "/routematrix/v2/riding",
    "method": "GET",
    "encoding": "json",
    "allow": [
      "status",
      "message",
      "result"
    ],
    "resilience": {
      "rate_limit": {
        "max_rate": 5,
        "every": "1s",
        "capacity": 5
      }
    }
  },
  "parameter_rules": {
    "properties": {
      "origins": {
        "type": "string",
        "min_length": 3,
        "max_length": 200
      },
      "destinations": {
        "type": "string",
        "min_length": 3,
        "max_length": 200
      }
    },
    "required_any_of": [
      [
        "origins"
      ],
      [
        "destinations"
      ]
    ]
  }
}
