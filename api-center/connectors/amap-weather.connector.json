{
  "id": "amap-weather",
  "enabled": true,
  "endpoint": "/data/amap/weather",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "5s",
  "input_query_strings": ["city", "extensions"],
  "secret_query": {"name": "key", "env": "AMAP_API_KEY"},
  "response_contract": {
    "status_path": "status",
    "success_values": ["1"],
    "error_code_path": "infocode",
    "message_path": "info",
    "any_data_paths": ["lives", "forecasts"]
  },
  "backend": {
    "host": "https://restapi.amap.com",
    "url_pattern": "/v3/weather/weatherInfo",
    "method": "GET",
    "encoding": "json",
    "allow": ["status", "info", "infocode", "count", "lives", "forecasts"]
  }
}
