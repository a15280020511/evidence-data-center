{
  "id": "baidu-coordinate-convert",
  "enabled": true,
  "endpoint": "/data/baidu/coordinate/convert",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "15s",
  "input_query_strings": [
    "coords",
    "from",
    "to"
  ],
  "secret_query": {
    "name": "ak",
    "env": "BAIDU_MAP_API_KEY"
  },
  "response_contract": {
    "status_path": "status",
    "success_values": [
      0
    ],
    "message_path": "message",
    "any_data_paths": [
      "result"
    ]
  },
  "backend": {
    "host": "https://api.map.baidu.com",
    "url_pattern": "/geoconv/v1/",
    "method": "GET",
    "encoding": "json",
    "allow": [
      "status",
      "message",
      "result"
    ],
    "resilience": {
      "rate_limit": {
        "max_rate": 5,
        "every": "1s",
        "capacity": 5
      }
    }
  },
  "parameter_rules": {
    "properties": {
      "coords": {
        "type": "string",
        "min_length": 3,
        "max_length": 4096
      },
      "from": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      },
      "to": {
        "type": "integer",
        "minimum": 3,
        "maximum": 6
      }
    },
    "required_any_of": [
      [
        "coords"
      ],
      [
        "from"
      ],
      [
        "to"
      ]
    ]
  }
}
