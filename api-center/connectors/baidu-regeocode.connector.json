{
  "id": "baidu-regeocode",
  "enabled": true,
  "endpoint": "/data/baidu/regeocode",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "15s",
  "input_query_strings": [
    "location",
    "coordtype",
    "ret_coordtype",
    "pois",
    "poi_types",
    "radius",
    "extensions_poi",
    "extensions_road",
    "extensions_town",
    "language",
    "language_auto"
  ],
  "secret_query": {
    "name": "ak",
    "env": "BAIDU_MAP_API_KEY"
  },
  "response_contract": {
    "status_path": "status",
    "success_values": [
      0
    ],
    "message_path": "message",
    "any_data_paths": [
      "result"
    ]
  },
  "backend": {
    "host": "https://api.map.baidu.com",
    "url_pattern": "/reverse_geocoding/v3/",
    "method": "GET",
    "encoding": "json",
    "allow": [
      "status",
      "message",
      "result"
    ],
    "resilience": {
      "rate_limit": {
        "max_rate": 5,
        "every": "1s",
        "capacity": 5
      }
    }
  },
  "parameter_rules": {
    "properties": {
      "location": {
        "type": "string",
        "min_length": 3,
        "max_length": 200
      },
      "radius": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "required_any_of": [
      [
        "location"
      ]
    ]
  }
}
