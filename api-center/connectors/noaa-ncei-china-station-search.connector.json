{
  "backend": {
    "allow": [
      "results",
      "totalCount",
      "formats",
      "dataTypes",
      "stations",
      "errorMessage",
      "errorCode",
      "errors"
    ],
    "encoding": "json",
    "host": "https://www.ncei.noaa.gov",
    "method": "GET",
    "resilience": {
      "circuit_breaker": {
        "interval": 60,
        "log_status_change": true,
        "max_errors": 3,
        "timeout": 30
      },
      "rate_limit": {
        "capacity": 1,
        "every": "1s",
        "max_rate": 1
      }
    },
    "url_pattern": "/access/services/search/v1/data"
  },
  "enabled": true,
  "endpoint": "/data/noaa/ncei/china/stations",
  "id": "noaa-ncei-china-station-search",
  "input_query_strings": [
    "dataset",
    "startDate",
    "endDate",
    "bbox",
    "dataTypes",
    "stations",
    "limit",
    "offset"
  ],
  "method": "GET",
  "output_encoding": "json",
  "parameter_rules": {
    "properties": {
      "bbox": {
        "enum": [
          "53.56,73.50,18.10,134.77"
        ],
        "type": "string"
      },
      "dataTypes": {
        "max_length": 1000,
        "pattern": "^[A-Z0-9,_-]{1,1000}$",
        "type": "string"
      },
      "dataset": {
        "enum": [
          "daily-summaries",
          "global-summary-of-the-month",
          "global-summary-of-the-year"
        ],
        "type": "string"
      },
      "endDate": {
        "max_length": 10,
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "limit": {
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
      },
      "startDate": {
        "max_length": 10,
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "stations": {
        "max_length": 119,
        "pattern": "^CH[A-Z0-9]{9}(?:,CH[A-Z0-9]{9}){0,9}$",
        "type": "string"
      }
    },
    "required_any_of": [
      [
        "dataset"
      ],
      [
        "startDate"
      ],
      [
        "endDate"
      ],
      [
        "bbox"
      ]
    ]
  },
  "response_contract": {
    "any_data_paths": [
      "results"
    ],
    "success_when_data_present": true
  },
  "response_quality": {
    "collection_path": "results",
    "hard_limit": 1000,
    "recommended_action": "Use the fixed China bounding box, a narrow date interval, and pagination to discover CH-prefixed Chinese stations before retrieving observations."
  },
  "timeout": "30s"
}
