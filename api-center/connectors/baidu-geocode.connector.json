{
  "id": "baidu-geocode",
  "enabled": true,
  "endpoint": "/data/baidu/geocode",
  "method": "GET",
  "output_encoding": "json",
  "timeout": "10s",
  "input_query_strings": [
    "address",
    "city",
    "output",
    "ret_coordtype"
  ],
  "secret_query": {
    "name": "ak",
    "env": "BAIDU_MAP_API_KEY"
  },
  "parameter_rules": {
    "properties": {
      "address": {
        "type": "string",
        "min_length": 1,
        "max_length": 200
      },
      "city": {
        "type": "string",
        "min_length": 1,
        "max_length": 100
      },
      "output": {
        "type": "string",
        "enum": [
          "json"
        ]
      },
      "ret_coordtype": {
        "type": "string",
        "enum": [
          "gcj02ll",
          "bd09ll"
        ]
      }
    },
    "required_any_of": [
      [
        "address"
      ]
    ]
  },
  "response_contract": {
    "status_path": "status",
    "success_values": [
      0
    ],
    "message_path": "message",
    "any_data_paths": [
      "result"
    ]
  },
  "backend": {
    "host": "https://api.map.baidu.com",
    "url_pattern": "/geocoding/v3/",
    "method": "GET",
    "encoding": "json",
    "allow": [
      "status",
      "result",
      "message"
    ],
    "resilience": {
      "rate_limit": {
        "max_rate": 5,
        "every": "1s",
        "capacity": 5
      }
    }
  }
}
