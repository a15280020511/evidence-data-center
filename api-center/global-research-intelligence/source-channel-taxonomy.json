{
  "schema_version": "global-source-channel-taxonomy-v2",
  "reviewed_at": "2026-08-07",
  "purpose": "Classify global information acquisition channels beyond APIs for governed intelligence collection, including machine publication, public documents, searchable systems, authorized sources, formal requests and physical-world observation.",
  "principles": [
    "Prefer machine-published official channels before browser automation",
    "Prefer primary sources before secondary aggregators",
    "Prefer incremental retrieval over full rescans",
    "Preserve source identity, publication time, license, retrieval time and provenance",
    "Do not bypass authentication, CAPTCHA, WAF, access restrictions or provider denial",
    "Use search engines and aggregators for discovery; verify material claims against primary sources",
    "Treat a channel as transport; authorization, privacy, secrecy, data-content and jurisdiction controls remain independent",
    "Physical-world collection must be public or authorized and must respect privacy, geospatial and sector restrictions"
  ],
  "tiers": {
    "A0_MACHINE_NATIVE": "Machine-oriented public feeds, registries, streams, repositories and downloads",
    "A1_STABLE_PUBLIC_DOCUMENT": "Stable public pages, documents, publications, filings and notices",
    "A2_PUBLIC_SEARCH_AND_INTERACTIVE": "Public searchable databases, dashboards, maps and interactive portals requiring bounded queries",
    "A3_AUTHENTICATED_OR_CONDITIONAL": "Account, member, paid, licensed, partner or otherwise conditional access requiring separate authorization review",
    "A4_FORMAL_REQUEST_OR_HUMAN_MEDIATED": "Lawful request, public-records application, archive/library request or other human-mediated acquisition",
    "A5_PHYSICAL_WORLD_OBSERVATION": "Public or authorized observation of the physical world through remote sensing, sensors, telemetry or field collection"
  },
  "channels": [
