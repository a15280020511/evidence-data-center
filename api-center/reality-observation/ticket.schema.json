{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reality observation bounded read-only ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "provider",
    "operation",
    "objective",
    "parameters",
    "data_policy",
    "acceptance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "provider": {
      "const": "reality-observation"
    },
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "planetary-stac-search",
        "earth-search-stac-search",
        "nasa-firms-area",
        "nasa-eonet-events",
        "celestrak-gp",
        "openaerialmap-search",
        "kartaview-nearby-photos",
        "ioos-erddap-search",
        "aviationweather-metar",
        "aviationweather-taf",
        "earthscope-stations",
        "noaa-swpc-kp",
        "noaa-swpc-solar-wind",
        "safecast-measurements",
        "opensensemap-boxes",
        "noaa-ndbc-latest",
        "noaa-coops-data",
        "melbourne-pedestrian-latest",
        "melbourne-pedestrian-history",
        "neso-generation-mix",
        "elexon-generation-summary",
        "elexon-demand-summary",
        "fingrid-dataset",
        "entsoe-document",
        "mapillary-image-search",
        "melbourne-transport-activity-latest"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "parameters": {
      "type": "object",
      "maxProperties": 10
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "contains_personal_data"
      ],
      "properties": {
        "classification": {
          "const": "public"
        },
        "contains_personal_data": {
          "const": false
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_response_bytes"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 20000000
        }
      }
    }
  }
}
