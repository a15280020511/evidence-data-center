          "operation_id": "stock-basic",
          "description": "按证券代码或名称读取证券基础资料。",
          "parameters": [
            "code",
            "code_name"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^(sh|sz|bj)\\.[0-9]{6}$"
              },
              "code_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "max_rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          },
          "result_contract": {
            "provider": "baostock",
            "client_package": "baostock==0.9.3",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "history-k",
          "description": "读取沪深京证券日/周/月或 5/15/30/60 分钟历史 K 线及估值字段。",
          "parameters": [
            "code",
            "fields",
            "start_date",
            "end_date",
            "frequency",
            "adjustflag"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^(sh|sz|bj)\\.[0-9]{6}$"
              },
              "fields": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_,]+$",
                "maxLength": 1000
              },
              "start_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "end_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "frequency": {
                "type": "string",
                "enum": [
                  "d",
                  "w",
                  "m",
                  "5",
                  "15",
                  "30",
                  "60"
                ]
              },
              "adjustflag": {
                "type": "string",
                "enum": [
                  "1",
                  "2",
                  "3"
                ]
              }
            },
            "required": [
              "code",
              "fields",
              "start_date",
              "end_date"
            ]
          },
          "result_contract": {
            "provider": "baostock",
            "client_package": "baostock==0.9.3",
            "read_only": true,
            "credential_mode": "none"
          }
        },
