                    "id",
                    "guid",
                    "display_title",
                    "docdt",
                    "docty",
                    "majdocty",
                    "count",
                    "countcode",
                    "lang",
                    "authr",
                    "abstracts",
                    "projectid",
                    "projn",
                    "repnb",
                    "repnme",
                    "pdfurl",
                    "txturl",
                    "url",
                    "topicv3",
                    "keywd",
                    "src_cit"
                  ]
                }
              }
            },
            "required": [
              "document_id"
            ]
          },
          "result_contract": {
            "provider": "worldbank-documents",
            "official_origin": "https://search.worldbank.org/api/v3/wds",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "none"
          }
        },
