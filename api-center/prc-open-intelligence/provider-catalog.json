{
  "schema_version": "prc-open-intelligence-provider-catalog-v1",
  "ticket_prefix": "[api]",
  "required_secret_environment_variable": "",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "china-check",
      "display_name": "China-Check 免费中国企业基础核验",
      "description": "通过固定的无认证 MCP 只读端点查询中国大陆企业基础登记信息；仅保留企业级公开字段，自动剔除个人联系信息和付费升级字段。",
      "enabled": true,
      "catalog_policy": "只允许固定 MCP 端点和两个公开只读工具；不得提交任意 URL、Cookie、Authorization、代理、脚本或付费操作。",
      "execution_policy": "每张票据最多执行一次 company-search 或 company-snapshot；遇到 401/403/429/CAPTCHA/WAF/区域拒绝立即停止，不换 IP、账号、工具或执行出口重试。China-Check 仅作为可替换的基础企业核验源，不作为唯一事实来源。",
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取 China-Check 本地安全能力目录，不访问上游。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        },
        {
          "operation_id": "company-search",
          "description": "按企业名称、品牌、域名、电话或统一社会信用代码搜索中国大陆企业；输出基础企业匹配并移除个人字段。",
          "parameters": [
            "query",
            "language"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "language": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$",
                "maxLength": 16
              }
            },
            "required": [
              "query"
            ]
          },
          "result_contract": {
            "provider": "china-check",
            "endpoint": "https://www.china-check.com/api/mcp/mcp",
            "mcp_tool": "search_chinese_company",
            "read_only": true,
            "auth": "none"
          }
        },
        {
          "operation_id": "company-snapshot",
          "description": "读取单家公司免费的基础登记快照；仅输出公开企业字段，不自动购买或进入付费报告。",
          "parameters": [
            "query",
            "company_id",
            "language"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "company_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "language": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$",
                "maxLength": 16
              }
            },
            "anyOf": [
              {
                "required": [
                  "query"
                ]
              },
              {
                "required": [
                  "company_id"
                ]
              }
            ]
          },
          "result_contract": {
            "provider": "china-check",
            "endpoint": "https://www.china-check.com/api/mcp/mcp",
            "mcp_tool": "get_company_snapshot",
            "read_only": true,
            "auth": "none",
            "paid_report_purchase_allowed": false
          }
        }
      ],
      "limits": {
        "requests_per_ticket": 1,
        "timeout_seconds_default": 20,
        "timeout_seconds_hard": 45,
        "max_response_bytes": 1000000,
        "free_snapshot_budget_assumption_per_day": 3,
        "automatic_paid_overage": false,
        "arbitrary_urls_allowed": false,
        "cookies_allowed": false,
        "proxy_rotation_allowed": false,
        "captcha_solving_allowed": false,
        "cross_provider_retry_after_denial": false,
        "fallback_policy": "return structured failure; official public sources may be queried only as a new independent task"
      }
    },
    {
      "provider_id": "sinofacts",
      "display_name": "SinoFacts 中国科技与出海企业开放事实库",
      "description": "读取 SinoFacts 在 GitHub 发布的 CC BY 4.0 企业事实快照，包含来源、验证日期和置信度；适用于科技、软件与出海企业的证据增强。",
      "enabled": true,
      "catalog_policy": "仅读取固定 GitHub Raw 文件 index.json 与 companies.jsonl；禁止任意仓库、任意 URL、写操作和全库再分发。",
      "execution_policy": "按企业名称、slug 或公开关键词进行有界本地过滤；每次最多返回 20 个匹配或 1 个企业记录，保留来源和许可证信息。",
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取 SinoFacts 本地安全能力目录，不访问上游。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        },
        {
          "operation_id": "company-search",
          "description": "在 SinoFacts 开放索引中搜索企业并返回有界匹配。",
          "parameters": [
            "query",
            "max_results"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "max_results": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "query"
            ]
          },
          "result_contract": {
            "provider": "sinofacts",
            "endpoint": "https://raw.githubusercontent.com/SinoFacts/dataset/main/index.json",
            "license": "CC BY 4.0",
            "read_only": true
          }
        },
        {
          "operation_id": "company-profile",
          "description": "按 slug 或企业名称在 SinoFacts JSONL 快照中返回单个完整公开记录，并附来源和 CC BY 4.0 归属信息。",
          "parameters": [
            "query"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "query"
            ]
          },
          "result_contract": {
            "provider": "sinofacts",
            "endpoint": "https://raw.githubusercontent.com/SinoFacts/dataset/main/companies.jsonl",
            "license": "CC BY 4.0",
            "read_only": true,
            "max_records": 1
          }
        }
      ],
      "limits": {
        "requests_per_ticket": 1,
        "timeout_seconds_default": 20,
        "timeout_seconds_hard": 45,
        "max_response_bytes": 1500000,
        "max_results": 20,
        "full_database_mirroring_allowed": false,
        "automatic_paid_overage": false,
        "arbitrary_urls_allowed": false,
        "upstream_snapshot_max_bytes": 5000000
      }
    }
  ],
  "execution_surface": "generic-api-local-bridge",
  "direct_issue_route_enabled": false
}
