{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/prc-open-intelligence-ticket.schema.json",
  "title": "PRC Open Intelligence Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "provider", "operation", "parameters", "data_policy"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
    "provider": {"type": "string", "enum": ["china-check", "sinofacts"]},
    "operation": {"type": "string", "enum": ["catalog-capabilities", "company-search", "company-snapshot", "company-profile"]},
    "objective": {"type": "string", "maxLength": 1000},
    "parameters": {"type": "object", "maxProperties": 10},
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {
        "classification": {"const": "public"},
        "contains_personal_data": {"const": false},
        "notes": {"type": "string", "maxLength": 500}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 45},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 1500000}
      }
    }
  }
}
