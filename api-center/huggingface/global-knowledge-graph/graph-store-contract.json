{
  "schema_version": "hf-global-knowledge-graph-store-v1",
  "status": "production-control",
  "dataset_visibility": "public",
  "default_repository_name": "global-knowledge-graph",
  "remote_root": "knowledge-graph/v1",
  "source_registry": "api-center/global-knowledge-registry/registry-index.json",
  "graph_contract": "api-center/global-knowledge-registry/graph-contract.json",
  "payload_policy": {
    "public_metadata_only": true,
    "open_or_source_declared_reusable_only": true,
    "full_text_default": "link-only",
    "patient_level_data_allowed": false,
    "personal_profiling_allowed": false,
    "paywall_bypass_allowed": false,
    "restricted_data_copying_allowed": false,
    "secrets_in_payload_allowed": false
  },
  "storage": {
    "format": "parquet",
    "compression": "zstd",
    "files": [
      "knowledge-graph/v1/nodes.parquet",
      "knowledge-graph/v1/edges.parquet",
      "knowledge-graph/v1/source-state.parquet",
      "knowledge-graph/v1/manifest.json",
      "README.md"
    ],
    "history": "huggingface-commit-history",
    "deduplication": {
      "nodes": "kg_id",
      "edges": "edge_id",
      "source_state": "source_id"
    }
  },
  "limits": {
    "requests_per_source_per_run": 1,
    "source_count_per_run_max": 5,
    "timeout_seconds": 60,
    "max_response_bytes": 25000000,
    "records_per_source_per_run_max": 5000,
    "automatic_retry_max": 0,
    "redirects_allowed": true,
    "fixed_redirect_hosts_only": true
  },
  "seed_graph": {
    "expected_registered_source_count": 249,
    "source_node_type": "Source",
    "source_edge_generation": false
  },
  "governance": {
    "gpts_is_sole_cross_center_relay": true,
    "direct_center_to_center_calls_allowed": false,
    "write_operations_to_upstreams_allowed": false,
    "source_provenance_required": true,
    "license_and_rights_fields_required": true,
    "temporal_fields_required": true
  }
}
