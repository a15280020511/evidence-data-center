{
  "schema_version": "global-knowledge-graph-harvest-plan-v1",
  "active_sources": [
    {
      "source_id": "re3data",
      "name": "re3data Registry of Research Data Repositories",
      "endpoint": "https://www.re3data.org/api/v40/repositories",
      "format": "xml",
      "credential_mode": "none",
      "license": "CC0 registry metadata; cite re3data",
      "node_type": "Collection",
      "edge_type": "REGISTERED_IN",
      "max_records": 5000
    },
    {
      "source_id": "ols",
      "name": "EMBL-EBI Ontology Lookup Service",
      "endpoint": "https://www.ebi.ac.uk/ols4/api/ontologies?size=500&page=0",
      "format": "json",
      "credential_mode": "none",
      "license": "CC0 API metadata",
      "node_type": "Collection",
      "edge_type": "REGISTERED_IN",
      "max_records": 500
    },
    {
      "source_id": "obo-foundry",
      "name": "OBO Foundry Ontology Registry",
      "endpoint": "https://obofoundry.org/registry/ontologies.jsonld",
      "format": "jsonld",
      "credential_mode": "none",
      "license": "Open registry metadata; preserve ontology-level rights",
      "node_type": "Collection",
      "edge_type": "REGISTERED_IN",
      "max_records": 1000
    },
    {
      "source_id": "optimade-providers",
      "name": "OPTIMADE Providers Index Meta-Database",
      "endpoint": "https://providers.optimade.org/providers.json",
      "format": "jsonapi",
      "credential_mode": "none",
      "license": "Open provider registry metadata",
      "node_type": "Source",
      "edge_type": "REGISTERED_IN",
      "max_records": 1000
    },
    {
      "source_id": "fairsharing-oai",
      "name": "FAIRsharing OAI-PMH",
      "endpoint": "https://api.fairsharing.org/oai?verb=ListRecords&metadataPrefix=oai_dc",
      "format": "oai-pmh",
      "credential_mode": "none",
      "license": "CC BY-SA 4.0",
      "node_type": "Source",
      "edge_type": "REGISTERED_IN",
      "max_records": 1000
    }
  ],
  "conditional_sources": [
    {
      "source_id": "opendoar",
      "name": "OpenDOAR",
      "credential_env": "OPENDOAR_API_KEY",
      "status": "conditional-free",
      "reason": "The current API requires an x-api-key and key issuance was paused during the 2026 migration; activate only after a valid key is configured and a dedicated live contract is verified."
    },
    {
      "source_id": "fairsharing-rest",
      "name": "FAIRsharing REST",
      "credential_env": "FAIRSHARING_USERNAME_PASSWORD",
      "status": "conditional-free",
      "reason": "The REST API requires an account; the keyless OAI-PMH metadata path is used for the public graph."
    }
  ],
  "deferred_sources": [
    {
      "source_id": "bartoc",
      "name": "BARTOC",
      "status": "deferred",
      "reason": "BARTOC Skosmos is being rebuilt and the stable registry-wide API contract is not verified; keep it in the source registry until production acceptance succeeds."
    }
  ],
  "schedule_policy": {
    "cadence": "daily",
    "mode": "bounded-refresh",
    "all_active_sources_each_run": true,
    "fairsharing_resumption_token": "persisted-in-source-state",
    "replace_or_merge": "merge-by-stable-id",
    "source_failures": "record-and-continue",
    "minimum_successful_sources": 3
  }
}
