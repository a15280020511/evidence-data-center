{
  "collection_layers": [
    {
      "id": "sources",
      "purpose": "Source catalog, issuer, endpoint or acquisition path, coverage, update cadence, access method and collection status."
    },
    {
      "id": "raw-snapshots",
      "purpose": "Immutable original files or captures exactly as collected, with checksums and collection timestamps."
    },
    {
      "id": "normalized-records",
      "purpose": "Standardized tabular or document records with stable field names, typed values and source lineage."
    },
    {
      "id": "time-series",
      "purpose": "Point-in-time time series with observation date, publication date, revision vintage, frequency, units and seasonal treatment."
    },
    {
      "id": "entity-master",
      "purpose": "Canonical entities, aliases, identifiers, ownership or hierarchy links, active periods and resolution confidence."
    },
    {
      "id": "variable-dictionaries",
      "purpose": "Variable definitions, units, code lists, missing-value semantics, transformations, publication lag and revision behavior."
    },
    {
      "id": "crosswalks",
      "purpose": "Geographic, industry, organization, security, product, unit, currency, calendar and variable mappings."
    },
    {
      "id": "derived-indicators",
      "purpose": "Evidence-backed indicators derived from stored source data, with formulas, implementation IDs and leakage controls."
    },
    {
      "id": "rule-snapshots",
      "purpose": "Effective-dated laws, policies, taxes, standards, trading, regulatory and operational parameters."
    },
    {
      "id": "event-timelines",
      "purpose": "Timestamped events, regime changes, disruptions, interventions, announcements, corrections and resolutions."
    },
    {
      "id": "quality-reports",
      "purpose": "Coverage, consistency, missingness, bias, timeliness, revision, drift and cross-source validation evidence."
    },
    {
      "id": "licenses-provenance",
      "purpose": "License, lawful basis, attribution, redistribution and commercial-use scope, source citation and collection provenance."
    },
    {
      "id": "manifests",
      "purpose": "Versioned manifests linking files, schemas, hashes, scope, limitations, release state and review dates."
    }
  ],
