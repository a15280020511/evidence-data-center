        "simple_markov_baseline"
      ],
      "required_metrics": [
        "parameter_recovery",
        "population_share_error",
        "mechanism_sensitivity",
        "multi_seed_stability",
        "non_identifiability"
      ]
    },
    {
      "id": "information-diffusion",
      "priority": "P3",
