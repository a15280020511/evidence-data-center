        "event_onset_and_resolution_labels",
        "false_alarm_and_missed_event_costs",
        "regime_and_drift_annotations"
      ],
      "required_baselines": [
        "historical_base_rate",
        "fixed_threshold",
        "simple_logistic_baseline"
      ],
      "required_metrics": [
        "Brier",
        "ECE",
        "PR_AUC",
        "false_positive",
        "false_negative",
        "lead_time",
        "threshold_loss",
        "drift"
