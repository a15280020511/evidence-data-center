      "required_datasets": [
        "china_population_and_administrative_crosswalks",
        "commercial_and_enterprise_indicators",
        "geospatial_and_transport_context",
        "finance_and_macro_series",
        "policy_and_regulatory_snapshots",
        "urban_services_and_environmental_indicators"
      ],
      "required_baselines": [
        "official_published_aggregate",
        "simple_historical_baseline",
        "cross_source_consistency_baseline"
      ],
      "required_metrics": [
        "source_consistency",
        "coverage",
        "timeliness",
