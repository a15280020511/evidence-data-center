{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/evidence-data-center/api-center/qweather/ticket.schema.json",
  "title": "QWeather managed read-only ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "provider", "operation", "objective", "parameters", "data_policy", "acceptance"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "provider": {"const": "qweather"},
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "geo-city-lookup",
        "geo-city-top",
        "geo-poi-lookup",
        "geo-poi-range",
        "weather-now",
        "weather-daily",
        "weather-hourly",
        "minutely-precipitation",
        "grid-weather-now",
        "grid-weather-daily",
        "grid-weather-hourly",
        "air-quality-current",
        "air-quality-hourly",
        "air-quality-daily",
        "weather-indices",
        "historical-weather",
        "solar-radiation-forecast"
      ]
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
    "parameters": {"type": "object", "maxProperties": 12},
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {
        "classification": {"const": "public"},
        "contains_personal_data": {"const": false}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_response_bytes", "max_rows"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 60},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 5000000},
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 5000}
      }
    }
  }
}
