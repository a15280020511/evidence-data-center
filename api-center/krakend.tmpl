      "endpoint": "/data/amap/direction/driving",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "host": [
            "https://restapi.amap.com"
          ],
          "url_pattern": "/v5/direction/driving",
          "method": "GET",
          "encoding": "json",
          "extra_config": {
            "qos/circuit-breaker": {
              "interval": 60,
              "timeout": 30,
              "max_errors": 3,
              "name": "cb-amap-direction-driving",
              "log_status_change": true
            },
            "modifier/martian": {
              "querystring.Modifier": {
                "scope": [
                  "request"
                ],
                "name": "key",
                "value": {{ env "AMAP_API_KEY" | quote }}
              }
            }
          },
          "allow": [
            "status",
            "info",
            "infocode",
            "count",
            "route"
          ]
        }
      ],
      "timeout": "8s",
      "input_query_strings": [
        "origin",
        "destination",
        "waypoints",
        "strategy",
        "avoidpolygons",
        "avoidroad",
