          ],
          "url_pattern": "/v3/assistant/coordinate/convert",
          "method": "GET",
          "encoding": "json",
          "extra_config": {
            "qos/circuit-breaker": {
              "interval": 60,
              "timeout": 30,
              "max_errors": 3,
              "name": "cb-amap-coordinate-convert",
              "log_status_change": true
            },
            "qos/ratelimit/proxy": {
              "max_rate": 5.0,
              "every": "1s",
              "capacity": 5
            },
            "modifier/martian": {
              "querystring.Modifier": {
                "scope": [
                  "request"
                ],
                "name": "key",
                "value": {{ env "AMAP_API_KEY" | quote }}
              }
            }
          },
          "allow": [
            "status",
            "info",
            "infocode",
            "count",
            "locations"
          ]
        }
      ],
      "timeout": "12s",
