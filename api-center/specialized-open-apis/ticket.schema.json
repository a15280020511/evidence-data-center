{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-system.example/schemas/specialized-open-apis-ticket-v1.json",
  "title": "Specialized Open APIs Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "provider", "operation", "objective", "parameters", "data_policy", "acceptance"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,119}$"},
    "provider": {"const": "specialized-open-apis"},
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "source-access-matrix",
        "nhm-dataset-search",
        "optimade-structures",
        "gov-uk-search",
        "rijksmuseum-collection-search",
        "bgs-collections"
      ]
    },
    "objective": {"type": "string", "minLength": 3, "maxLength": 1000},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 200},
        "limit": {"type": "integer", "minimum": 1, "maximum": 50},
        "provider": {"type": "string", "enum": ["mc3d-pbe-v1", "mc3d-pbesol-v1", "mc2d", "pyrene-mofs"]},
        "elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][a-z]?$"}
        },
        "order": {"type": "string", "enum": ["-public_timestamp", "public_timestamp", "relevance"]},
        "field": {"type": "string", "enum": ["title", "creator", "type", "material", "description", "aboutActor", "technique", "objectNumber", "creationDate"]},
        "image_available": {"type": "boolean"}
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {
        "classification": {"const": "public"},
        "contains_personal_data": {"const": false},
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 90},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 10000000}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"enum": ["nhm-dataset-search", "gov-uk-search", "rijksmuseum-collection-search"]}}},
      "then": {"properties": {"parameters": {"required": ["query"]}}}
    },
    {
      "if": {"properties": {"operation": {"enum": ["catalog-capabilities", "source-access-matrix", "bgs-collections"]}}},
      "then": {"properties": {"parameters": {"maxProperties": 0}}}
    }
  ]
}
