{
  "schema_version": "specialized-open-apis-provider-catalog-v1",
  "secret_values_exposed": false,
  "providers": [
    {
      "provider_id": "specialized-open-apis",
      "display_name": "全球专业细分开放API",
      "description": "覆盖自然历史、材料科学、政府政策文献、博物馆馆藏和地质数据目录的固定只读接口。",
      "enabled": true,
      "ticket_prefix": "[intel-specialized-open]",
      "required_secret_environment_variable": "",
      "catalog_policy": "仅允许固定官方主机、固定操作和受限参数；禁止任意URL、任意OPTIMADE过滤器、自动翻页、自动重试、重定向、写入和个人画像。",
      "execution_policy": "每张票据最多一次上游请求；结果、超时和响应体有上限；真实验收后才升级生产。",
      "limits": {
        "requests_per_ticket_max": 1,
        "timeout_seconds_max": 90,
        "max_response_bytes": 10000000,
        "automatic_retry_allowed": false,
        "automatic_pagination_allowed": false,
        "redirects_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_query_languages_allowed": false,
        "write_operations_allowed": false,
        "personal_profiling_allowed": false,
        "secret_values_exposed": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地能力目录。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}},
          "result_contract": {"official_endpoint": "LOCAL", "http_method": "LOCAL", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "source-access-matrix",
          "description": "读取细分专业来源和验收状态。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}},
          "result_contract": {"official_endpoint": "LOCAL", "http_method": "LOCAL", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "nhm-dataset-search",
          "description": "检索英国自然历史博物馆研究和馆藏数据集。",
          "parameters": ["query", "limit"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "required": ["query"], "properties": {"query": {"type": "string", "minLength": 1, "maxLength": 200}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}},
          "result_contract": {"official_endpoint": "https://data.nhm.ac.uk/api/3/action/package_search", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "optimade-structures",
          "description": "从Materials Cloud固定OPTIMADE数据库读取受限数量的材料晶体结构。",
          "parameters": ["provider", "elements", "limit"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {"provider": {"type": "string", "enum": ["mc3d-pbe-v1", "mc3d-pbesol-v1", "mc2d", "pyrene-mofs"]}, "elements": {"type": "array", "minItems": 1, "maxItems": 5}, "limit": {"type": "integer", "minimum": 1, "maximum": 20}}},
          "result_contract": {"official_endpoint": "fixed Materials Cloud OPTIMADE /v1/structures endpoint", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "gov-uk-search",
          "description": "检索GOV.UK政策、法规说明、指南、统计和政府出版物。",
          "parameters": ["query", "limit", "order"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "required": ["query"], "properties": {"query": {"type": "string", "minLength": 1, "maxLength": 200}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}, "order": {"type": "string", "enum": ["-public_timestamp", "public_timestamp", "relevance"]}}},
          "result_contract": {"official_endpoint": "https://www.gov.uk/api/search.json", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "rijksmuseum-collection-search",
          "description": "按固定字段检索Rijksmuseum公开馆藏Linked Open Data标识。",
          "parameters": ["field", "query", "image_available"],
          "parameter_schema": {"type": "object", "additionalProperties": false, "required": ["query"], "properties": {"field": {"type": "string", "enum": ["title", "creator", "type", "material", "description", "aboutActor", "technique", "objectNumber", "creationDate"]}, "query": {"type": "string", "minLength": 1, "maxLength": 160}, "image_available": {"type": "boolean"}}},
          "result_contract": {"official_endpoint": "https://data.rijksmuseum.nl/search/collection", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        },
        {
          "operation_id": "bgs-collections",
          "description": "读取BGS OpenGeoscience OGC API的地质、地震、滑坡、钻孔和传感器集合目录。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}},
          "result_contract": {"official_endpoint": "https://ogcapi.bgs.ac.uk/collections?f=json", "http_method": "GET", "read_only": true, "credential_mode": "none"}
        }
      ]
    }
  ]
}
