{
  "schema_version": "web-retrieval-provider-catalog-v2",
  "ticket_prefix": "[api-web]",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "jina-reader",
      "display_name": "Jina AI Reader",
      "description": "使用 Jina Reader 将公开网页或公开 PDF 转换为适合大模型使用的 Markdown/JSON 内容。",
      "enabled": true,
      "ticket_prefix": "[api-web]",
      "required_secret_environment_variable": "",
      "optional_secret_environment_variable": "JINA_API_KEY",
      "catalog_policy": "只允许读取调用方明确提供的公开 HTTPS URL；禁止内网、回环、链路本地、保留地址、登录态 Cookie、任意请求头和任意代码。",
      "execution_policy": "无 Key 时使用 Jina Reader 官方匿名基础额度；配置 JINA_API_KEY 时仅在后端 Authorization Bearer 头注入以提高额度。每张票据最多读取一个 URL。",
      "limits": {
        "requests_per_ticket": 1,
        "timeout_seconds_max": 120,
        "max_response_bytes": 5000000,
        "max_tokens": 20000
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取 Jina Reader 本地安全能力目录，不访问上游且不需要密钥。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}}
        },
        {
          "operation_id": "read-url",
          "description": "通过 r.jina.ai 读取一个公开 HTTPS 网页或 PDF，返回 LLM 友好的正文。",
          "parameters": ["url", "max_tokens", "no_cache"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"},
              "max_tokens": {"type": "integer", "minimum": 500, "maximum": 20000},
              "no_cache": {"type": "boolean"}
            },
            "required": ["url"]
          },
          "result_contract": {
            "provider": "jina-reader",
            "official_endpoint": "https://r.jina.ai/<public-https-url>",
            "http_method": "GET",
            "read_only": true,
            "anonymous_supported": true,
            "optional_secret": "JINA_API_KEY"
          },
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://jina.ai/reader/"}
        }
      ]
    },
    {
      "provider_id": "exa",
      "display_name": "Exa Search API",
      "description": "使用 Exa 官方搜索与 Contents API 搜索公开网页并提取干净、适合大模型使用的内容。",
      "enabled": true,
      "ticket_prefix": "[api-web]",
      "required_secret_environment_variable": "EXA_API_KEY",
      "catalog_policy": "只暴露固定的 Exa /search 与 /contents 只读接口；禁止 Answer、Agent、Research、Websets、联系人富集、任意 URL 主机和任意请求头。",
      "execution_policy": "EXA_API_KEY 仅在后端 x-api-key 头注入；每张票据只执行一次调用；搜索最多10条，Contents最多5个公开 HTTPS URL，不启用摘要或联系人富集。",
      "limits": {
        "requests_per_ticket": 1,
        "timeout_seconds_max": 120,
        "max_response_bytes": 5000000,
        "search_results_max": 10,
        "content_urls_max": 5
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取 Exa 本地安全能力目录，不访问上游且不需要密钥。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}}
        },
        {
          "operation_id": "search",
          "description": "调用 Exa /search 搜索公开网页，可返回结果元数据及受限的 highlights 或正文。",
          "parameters": ["query", "num_results", "search_type", "content_mode", "max_characters"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {"type": "string", "minLength": 1, "maxLength": 1000},
              "num_results": {"type": "integer", "minimum": 1, "maximum": 10},
              "search_type": {"type": "string", "enum": ["auto", "fast", "instant"]},
              "content_mode": {"type": "string", "enum": ["none", "highlights", "text"]},
              "max_characters": {"type": "integer", "minimum": 500, "maximum": 20000}
            },
            "required": ["query"]
          },
          "result_contract": {"provider": "exa", "official_endpoint": "https://api.exa.ai/search", "http_method": "POST", "read_only": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://exa.ai/docs/reference/search"}
        },
        {
          "operation_id": "contents",
          "description": "调用 Exa /contents 读取最多5个已知公开 HTTPS URL 的正文或 highlights。",
          "parameters": ["urls", "content_mode", "highlight_query", "max_characters", "max_age_hours"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "urls": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"}},
              "content_mode": {"type": "string", "enum": ["highlights", "text"]},
              "highlight_query": {"type": "string", "minLength": 1, "maxLength": 1000},
              "max_characters": {"type": "integer", "minimum": 500, "maximum": 20000},
              "max_age_hours": {"type": "integer", "minimum": 0, "maximum": 720}
            },
            "required": ["urls"]
          },
          "result_contract": {"provider": "exa", "official_endpoint": "https://api.exa.ai/contents", "http_method": "POST", "read_only": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://exa.ai/docs/reference/get-contents"}
        }
      ]
    },
    {
      "provider_id": "tavily",
      "display_name": "Tavily Context API",
      "description": "使用 Tavily 官方 Search、Extract、Map 与 Crawl API 获取面向大模型的实时公开网页证据。",
      "enabled": true,
      "ticket_prefix": "[api-context]",
      "required_secret_environment_variable": "TAVILY_API_KEY",
      "catalog_policy": "只暴露 Tavily 固定只读端点；禁止 Research、异步研究任务、自动参数升级、任意请求头、任意代码和非公开 URL。",
      "execution_policy": "TAVILY_API_KEY 仅在后端 Authorization Bearer 头注入；每张票据执行一次请求；Search 默认 basic 且关闭自动参数和生成式答案；Extract 最多5个 URL；Map 最多50个链接；Crawl 最多20页且深度最多2。",
      "limits": {
        "requests_per_ticket": 1,
        "timeout_seconds_max": 150,
        "max_response_bytes": 5000000,
        "search_results_max": 10,
        "extract_urls_max": 5,
        "map_links_max": 50,
        "crawl_pages_max": 20,
        "crawl_depth_max": 2,
        "research_allowed": false,
        "auto_parameters_allowed": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取 Tavily 本地安全能力目录，不访问上游且不需要密钥。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}}
        },
        {
          "operation_id": "search",
          "description": "调用 Tavily /search 搜索公开网页，固定关闭自动参数和生成式答案。",
          "parameters": ["query", "search_depth", "topic", "max_results", "time_range", "include_domains", "exclude_domains", "country", "include_raw_content"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {"type": "string", "minLength": 1, "maxLength": 1000},
              "search_depth": {"type": "string", "enum": ["basic", "fast", "ultra-fast", "advanced"]},
              "topic": {"type": "string", "enum": ["general", "news", "finance"]},
              "max_results": {"type": "integer", "minimum": 1, "maximum": 10},
              "time_range": {"type": "string", "enum": ["day", "week", "month", "year"]},
              "include_domains": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
              "exclude_domains": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
              "country": {"type": "string", "minLength": 1, "maxLength": 64},
              "include_raw_content": {"type": "boolean"}
            },
            "required": ["query"]
          },
          "result_contract": {"provider": "tavily", "official_endpoint": "https://api.tavily.com/search", "http_method": "POST", "read_only": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://docs.tavily.com/documentation/api-reference/endpoint/search"}
        },
        {
          "operation_id": "extract",
          "description": "调用 Tavily /extract 提取最多5个公开 HTTPS URL 的 Markdown 或纯文本。",
          "parameters": ["urls", "extract_depth", "query", "format", "include_images"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "urls": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"}},
              "extract_depth": {"type": "string", "enum": ["basic", "advanced"]},
              "query": {"type": "string", "minLength": 1, "maxLength": 1000},
              "format": {"type": "string", "enum": ["markdown", "text"]},
              "include_images": {"type": "boolean"}
            },
            "required": ["urls"]
          },
          "result_contract": {"provider": "tavily", "official_endpoint": "https://api.tavily.com/extract", "http_method": "POST", "read_only": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://docs.tavily.com/documentation/api-reference/endpoint/extract"}
        },
        {
          "operation_id": "map",
          "description": "调用 Tavily /map 发现一个公开站点的受限 URL 结构，不允许外部域名。",
          "parameters": ["url", "instructions", "max_depth", "max_breadth", "limit", "select_paths", "exclude_paths"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"},
              "instructions": {"type": "string", "minLength": 1, "maxLength": 500},
              "max_depth": {"type": "integer", "minimum": 1, "maximum": 3},
              "max_breadth": {"type": "integer", "minimum": 1, "maximum": 20},
              "limit": {"type": "integer", "minimum": 1, "maximum": 50},
              "select_paths": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
              "exclude_paths": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
            },
            "required": ["url"]
          },
          "result_contract": {"provider": "tavily", "official_endpoint": "https://api.tavily.com/map", "http_method": "POST", "read_only": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://docs.tavily.com/documentation/api-reference/endpoint/map"}
        },
        {
          "operation_id": "crawl",
          "description": "调用 Tavily /crawl 对一个公开站点执行受限同步爬取，最多20页、深度最多2。",
          "parameters": ["url", "instructions", "max_depth", "max_breadth", "limit", "select_paths", "exclude_paths", "extract_depth", "format"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"},
              "instructions": {"type": "string", "minLength": 1, "maxLength": 500},
              "max_depth": {"type": "integer", "minimum": 1, "maximum": 2},
              "max_breadth": {"type": "integer", "minimum": 1, "maximum": 20},
              "limit": {"type": "integer", "minimum": 1, "maximum": 20},
              "select_paths": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
              "exclude_paths": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
              "extract_depth": {"type": "string", "enum": ["basic", "advanced"]},
              "format": {"type": "string", "enum": ["markdown", "text"]}
            },
            "required": ["url"]
          },
          "result_contract": {"provider": "tavily", "official_endpoint": "https://api.tavily.com/crawl", "http_method": "POST", "read_only": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://docs.tavily.com/documentation/api-reference/endpoint/crawl"}
        }
      ]
    },
    {
      "provider_id": "firecrawl",
      "display_name": "Firecrawl Context API（火行者）",
      "description": "使用 Firecrawl v2 Search、Scrape 与 Map API 搜索公开网页、提取正文并发现站点 URL。",
      "enabled": true,
      "ticket_prefix": "[api-context]",
      "required_secret_environment_variable": "FIRECRAWL_API_KEY",
      "catalog_policy": "只暴露 Firecrawl v2 固定只读 Search、Scrape、Map；禁止 Crawl 异步任务、Agent、Browser、Interact、Actions、任意请求头、Cookie、登录态和非公开 URL。",
      "execution_policy": "FIRECRAWL_API_KEY 仅在后端 Authorization Bearer 头注入；每张票据执行一次请求；Search最多10条；Scrape仅允许Markdown和Links并启用零数据保留；Map最多100个链接且默认不含子域名。",
      "limits": {
        "requests_per_ticket": 1,
        "timeout_seconds_max": 150,
        "max_response_bytes": 5000000,
        "search_results_max": 10,
        "scrape_urls_max": 1,
        "map_links_max": 100,
        "browser_interaction_allowed": false,
        "actions_allowed": false,
        "arbitrary_headers_allowed": false,
        "async_crawl_allowed": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取 Firecrawl 本地安全能力目录，不访问上游且不需要密钥。",
          "parameters": [],
          "parameter_schema": {"type": "object", "additionalProperties": false, "properties": {}}
        },
        {
          "operation_id": "search",
          "description": "调用 Firecrawl v2 /search 搜索公开网页，可选择返回受限 Markdown。",
          "parameters": ["query", "limit", "country", "time_range", "include_markdown"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {"type": "string", "minLength": 1, "maxLength": 1000},
              "limit": {"type": "integer", "minimum": 1, "maximum": 10},
              "country": {"type": "string", "minLength": 2, "maxLength": 2, "pattern": "^[A-Za-z]{2}$"},
              "time_range": {"type": "string", "enum": ["day", "week", "month", "year"]},
              "include_markdown": {"type": "boolean"}
            },
            "required": ["query"]
          },
          "result_contract": {"provider": "firecrawl", "official_endpoint": "https://api.firecrawl.dev/v2/search", "http_method": "POST", "read_only": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://docs.firecrawl.dev/api-reference/endpoint/search"}
        },
        {
          "operation_id": "scrape",
          "description": "调用 Firecrawl v2 /scrape 读取一个公开 HTTPS URL，仅返回 Markdown 和/或链接。",
          "parameters": ["url", "formats", "only_main_content", "max_age_ms", "timeout_ms"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"},
              "formats": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["markdown", "links"]}},
              "only_main_content": {"type": "boolean"},
              "max_age_ms": {"type": "integer", "minimum": 0, "maximum": 604800000},
              "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000}
            },
            "required": ["url"]
          },
          "result_contract": {"provider": "firecrawl", "official_endpoint": "https://api.firecrawl.dev/v2/scrape", "http_method": "POST", "read_only": true, "zero_data_retention": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://docs.firecrawl.dev/api-reference/endpoint/scrape"}
        },
        {
          "operation_id": "map",
          "description": "调用 Firecrawl v2 /map 获取一个公开站点的受限 URL 列表。",
          "parameters": ["url", "search", "sitemap", "include_subdomains", "ignore_query_parameters", "limit"],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"},
              "search": {"type": "string", "minLength": 1, "maxLength": 500},
              "sitemap": {"type": "string", "enum": ["skip", "include", "only"]},
              "include_subdomains": {"type": "boolean"},
              "ignore_query_parameters": {"type": "boolean"},
              "limit": {"type": "integer", "minimum": 1, "maximum": 100}
            },
            "required": ["url"]
          },
          "result_contract": {"provider": "firecrawl", "official_endpoint": "https://api.firecrawl.dev/v2/map", "http_method": "POST", "read_only": true},
          "discovery_policy": {"source": "official-documentation", "documentation_url": "https://docs.firecrawl.dev/api-reference/endpoint/map"}
        }
      ]
    }
  ]
}
