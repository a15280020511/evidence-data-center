{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/evidence-data-center/api-center/connector.schema.json",
  "title": "Independent API Center Connector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "enabled",
    "endpoint",
    "method",
    "backend"
  ],
  "allOf": [
    {
      "not": {
        "required": [
          "secret_header",
          "secret_query"
        ]
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^/data/[A-Za-z0-9._~!$&'()*+,;=:@%/{}-]+$",
      "maxLength": 256
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST"
      ]
    },
    "write_approved": {
      "description": "Required and true for any enabled POST connector. Omit for GET connectors.",
      "const": true
    },
    "output_encoding": {
      "type": "string",
      "enum": [
        "json",
        "no-op",
        "string"
      ],
      "default": "json"
    },
    "timeout": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s)$"
    },
    "input_query_strings": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._~-]{1,64}$"
      }
    },
    "input_headers": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{1,64}$"
      }
    },
    "secret_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "env"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,64}$"
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        }
      }
    },
    "secret_query": {
      "description": "Inject one backend-only query parameter from a runtime environment variable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "env"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,64}$"
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        }
      }
    },
    "response_contract": {
      "description": "Declarative business-success and non-empty-data checks for formal [api] tickets.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "maxLength": 256
        },
        "success_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "error_code_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "maxLength": 256
        },
        "message_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "maxLength": 256
        },
        "any_data_paths": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
            "maxLength": 256
          }
        },
        "success_when_data_present": {
          "description": "For statusless public JSON APIs, treat a non-empty allowlisted data path as business success.",
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "status_path",
            "success_values"
          ]
        },
        {
          "required": [
            "success_when_data_present",
            "any_data_paths"
          ],
          "properties": {
            "success_when_data_present": {
              "const": true
            }
          }
        }
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "url_pattern"
      ],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^https?://[^\\s/]+(?::[0-9]{1,5})?$",
          "maxLength": 512
        },
        "url_pattern": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 1024
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST"
          ]
        },
        "encoding": {
          "type": "string",
          "enum": [
            "json",
            "no-op",
            "string"
          ]
        },
        "allow": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "resilience": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "circuit_breaker": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "interval": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                },
                "max_errors": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "log_status_change": {
                  "type": "boolean"
                }
              }
            },
            "rate_limit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_rate"
              ],
              "properties": {
                "max_rate": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "every": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              }
            }
          }
        }
      }
    },
    "path_parameters": {
      "description": "Allowlisted path placeholders. Values are validated and encoded before the gateway is called.",
      "type": "object",
      "maxProperties": 10,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern"
        ],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "max_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        }
      }
    },
    "parameter_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "properties": {
          "type": "object",
          "maxProperties": 50,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              },
              "enum": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "min_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "max_length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "pattern": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        "required_any_of": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "mutually_exclusive": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "response_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_path",
        "hard_limit"
      ],
      "properties": {
        "collection_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
        },
        "hard_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "recommended_action": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
