{
  "schema_version": "faostat-provider-catalog-v1",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "faostat",
      "display_name": "FAOSTAT 农业、粮食、贸易与排放统计",
      "description": "通过 FAO 官方 FAOSTAT API 读取农业生产、粮食安全、价格、贸易、投入、排放及相关代码表。",
      "enabled": true,
      "ticket_prefix": "[intel-faostat]",
      "required_secret_environment_variable": "FAOSTAT_PASSWORD",
      "required_repository_variable": "FAOSTAT_USERNAME",
      "catalog_policy": "固定访问 faostatservices.fao.org；用户名与密码仅用于后端登录，JWT仅驻留内存。",
      "execution_policy": "每张票据最多一次登录 POST 和一次业务 GET；无重试、无自动翻页；数据查询必须含筛选条件。",
      "official_documentation": "https://fenixservices.fao.org/faostat/static/bulkdownloads",
      "official_origin": "https://faostatservices.fao.org/api/v1",
      "limits": {
        "network_requests_per_ticket_max": 2,
        "business_requests_per_ticket_max": 1,
        "transient_retry_max": 0,
        "provider_concurrency_max": 1,
        "timeout_seconds_max": 120,
        "max_response_bytes": 20000000,
        "records_per_ticket_max": 500,
        "filter_dimensions_per_ticket_max": 12,
        "filter_values_per_dimension_max": 20,
        "fixed_api_host": "faostatservices.fao.org",
        "fixed_api_prefix": "/api/v1",
        "automatic_retry_allowed": false,
        "automatic_pagination_allowed": false,
        "bulk_download_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_hosts_allowed": false,
        "arbitrary_headers_allowed": false,
        "client_supplied_credentials_allowed": false,
        "oauth_token_persistence_allowed": false,
        "write_operations_allowed": false,
        "secret_values_exposed": false
      },
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取本地 FAOSTAT 能力目录。",
          "parameters": [],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "result_contract": {
            "provider": "faostat",
            "http_method": "LOCAL",
            "read_only": true,
            "credential_mode": "none"
          }
        },
        {
          "operation_id": "list-groups",
          "description": "读取 FAOSTAT 数据组。",
          "parameters": [
            "lang"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "es",
                  "fr"
                ]
              }
            }
          },
          "result_contract": {
            "provider": "faostat",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "oauth_password_login"
          }
        },
        {
          "operation_id": "list-datasets",
          "description": "读取 FAOSTAT 数据集目录。",
          "parameters": [
            "lang"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "es",
                  "fr"
                ]
              }
            }
          },
          "result_contract": {
            "provider": "faostat",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "oauth_password_login"
          }
        },
        {
          "operation_id": "list-parameters",
          "description": "读取数据集维度。",
          "parameters": [
            "dataset",
            "lang"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dataset": {
                "type": "string",
                "pattern": "^[A-Z0-9_]{1,16}$"
              },
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "es",
                  "fr"
                ]
              }
            },
            "required": [
              "dataset"
            ]
          },
          "result_contract": {
            "provider": "faostat",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "oauth_password_login"
          }
        },
        {
          "operation_id": "get-parameter-codes",
          "description": "读取数据集维度代码。",
          "parameters": [
            "dataset",
            "parameter",
            "lang"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dataset": {
                "type": "string",
                "pattern": "^[A-Z0-9_]{1,16}$"
              },
              "parameter": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,79}$"
              },
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "es",
                  "fr"
                ]
              }
            },
            "required": [
              "dataset",
              "parameter"
            ]
          },
          "result_contract": {
            "provider": "faostat",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "oauth_password_login"
          }
        },
        {
          "operation_id": "get-data-size",
          "description": "读取受限筛选条件的数据规模与首批结构。",
          "parameters": [
            "dataset",
            "lang",
            "filters",
            "page_number",
            "page_size"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dataset": {
                "type": "string",
                "pattern": "^[A-Z0-9_]{1,16}$"
              },
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "es",
                  "fr"
                ]
              },
              "filters": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 12,
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,79}$"
                  }
                }
              },
              "page_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              }
            },
            "required": [
              "dataset",
              "filters"
            ]
          },
          "result_contract": {
            "provider": "faostat",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "oauth_password_login"
          }
        },
        {
          "operation_id": "get-data",
          "description": "读取受限 FAOSTAT 数据页。",
          "parameters": [
            "dataset",
            "lang",
            "filters",
            "page_number",
            "page_size"
          ],
          "parameter_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dataset": {
                "type": "string",
                "pattern": "^[A-Z0-9_]{1,16}$"
              },
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "es",
                  "fr"
                ]
              },
              "filters": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 12,
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,79}$"
                  }
                }
              },
              "page_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              }
            },
            "required": [
              "dataset",
              "filters"
            ]
          },
          "result_contract": {
            "provider": "faostat",
            "http_method": "GET",
            "read_only": true,
            "credential_mode": "oauth_password_login"
          }
        }
      ]
    }
  ]
}
