{
  "schema_version": "un-comtrade-provider-catalog-v1",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "un-comtrade",
      "display_name": "联合国 UN Comtrade 全球贸易数据",
      "description": "通过联合国统计司 UN Comtrade 官方 API 读取全球货物与服务贸易、关税行、数据可用性、最近发布、元数据、贸易差额以及报告方和伙伴方参考代码。",
      "enabled": true,
      "ticket_prefix": "[intel-un-comtrade]",
      "required_secret_environment_variable": "UN_COMTRADE_API_KEY",
      "catalog_policy": "固定访问 comtradeapi.un.org；开放无需密钥的预览和固定参考表，以及使用独立 Subscription Key 的免费数据接口。禁止 Bulk、Async、文件下载、任意 URL、任意主机、客户端密钥、任意请求头、自动翻页和写操作。",
      "execution_policy": "每张票据只发送一次 GET，不自动重试或翻页；预览最多500条，正式数据、关税行和贸易差额在情报中心内硬限制为5000条。最多12个时期、5个报告方、20个商品代码、10个伙伴和20 MB响应。Subscription Key仅由GitHub Actions后端注入并在落盘前递归清除。",
      "official_documentation": "https://uncomtrade.org/docs/un-comtrade-api/",
      "official_origin": "https://comtradeapi.un.org",
      "service_status_notice": "UN Comtrade免费账户可申请API Subscription Key；官方当前说明免费基础账户最多500次API调用/日，预览接口无需密钥但最多500条记录。上游配额和产品权限以实际账户及响应为准。",
      "limits": {
        "requests_per_ticket_max": 1,
        "transient_retry_max": 0,
        "provider_concurrency_max": 1,
        "timeout_seconds_max": 60,
        "max_response_bytes": 20000000,
        "preview_records_max": 500,
        "records_per_request_max": 5000,
        "official_free_records_per_call_max": 100000,
        "free_api_calls_per_day": 500,
        "periods_per_ticket_max": 12,
        "reporters_per_ticket_max": 5,
        "commodity_codes_per_ticket_max": 20,
        "partners_per_ticket_max": 10,
        "fixed_api_host": "comtradeapi.un.org",
        "fixed_data_prefix": "/data/v1",
        "fixed_public_prefix": "/public/v1",
        "keyless_preview_allowed": true,
        "automatic_retry_allowed": false,
        "automatic_pagination_allowed": false,
        "bulk_api_allowed": false,
        "async_api_allowed": false,
        "file_downloads_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_hosts_allowed": false,
        "arbitrary_paths_allowed": false,
        "arbitrary_headers_allowed": false,
        "client_supplied_credentials_allowed": false,
        "background_crawling_allowed": false,
        "write_operations_allowed": false,
        "secret_values_exposed": false,
        "authentication_required": true
      },
