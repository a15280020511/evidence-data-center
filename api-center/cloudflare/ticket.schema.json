{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloudflare intelligence ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "provider", "operation", "parameters", "data_policy", "acceptance"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"},
    "provider": {"const": "cloudflare"},
    "operation": {"enum": ["catalog-capabilities", "browser-content", "browser-markdown", "browser-links", "browser-screenshot", "browser-pdf", "browser-snapshot", "browser-accessibility-tree", "radar-global-search", "radar-outages", "radar-outage-locations", "radar-http-summary", "radar-http-timeseries", "radar-ranking-top", "radar-ranking-domain", "radar-layer7-summary", "radar-layer7-top-attacks", "urlscanner-search", "urlscanner-result", "urlscanner-har", "urlscanner-dom", "urlscanner-screenshot"]},
    "parameters": {"type": "object"},
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {"classification": {"const": "public"}, "contains_personal_data": {"const": false}}
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_response_bytes"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 120},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 20000000}
      }
    }
  }
}
