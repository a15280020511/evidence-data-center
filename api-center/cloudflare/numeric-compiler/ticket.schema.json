{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloudflare China finance numeric compiler ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "profile_id", "url", "data_policy", "acceptance"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,120}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^cn-[a-z0-9-]{3,80}$"
    },
    "url": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data", "investment_recommendation_requested"],
      "properties": {
        "classification": {"const": "public"},
        "contains_personal_data": {"const": false},
        "investment_recommendation_requested": {"const": false}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_response_bytes", "minimum_confidence"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 120},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 5000000},
        "minimum_confidence": {"type": "number", "minimum": 0.5, "maximum": 1.0}
      }
    }
  }
}
