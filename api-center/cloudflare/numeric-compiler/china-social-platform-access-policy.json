{
  "schema_version": "china-social-platform-access-policy-v1",
  "status": "production-control",
  "platform_count": 5,
  "scope": "中国大陆主要社交与内容平台的公开、合法、非个人化情报采集边界",
  "global_policy": {
    "official_api_first": true,
    "browser_public_page_fallback_allowed": true,
    "login_bypass_allowed": false,
    "captcha_bypass_allowed": false,
    "anti_bot_evasion_allowed": false,
    "mobile_private_api_reverse_engineering_allowed": false,
    "user_cookie_pool_allowed": false,
    "private_message_collection_allowed": false,
    "personal_profile_building_allowed": false,
    "raw_content_persistence_allowed": false,
    "raw_comment_persistence_allowed": false,
    "numeric_aggregate_only": true,
    "enterprise_policy_topic_focus": true,
    "copyrighted_video_download_allowed": false,
    "deleted_or_restricted_content_recovery_allowed": false
  },
  "platforms": [
