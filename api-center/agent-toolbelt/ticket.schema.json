{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/evidence-data-center/api-center/agent-toolbelt/ticket.schema.json",
  "title": "agent-toolbelt managed read-only ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "provider",
    "operation",
    "objective",
    "parameters",
    "data_policy",
    "acceptance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "provider": {
      "const": "agent-toolbelt"
    },
    "operation": {
      "type": "string",
      "enum": [
        "catalog-capabilities",
        "schema-generator",
        "text-extractor",
        "token-counter",
        "csv-to-json",
        "markdown-converter",
        "url-metadata",
        "regex-builder",
        "cron-builder",
        "address-normalizer",
        "color-palette",
        "document-comparator",
        "contract-clause-extractor",
        "prompt-optimizer",
        "meeting-action-items",
        "image-metadata-stripper",
        "brand-kit",
        "api-response-mocker",
        "dependency-auditor",
        "web-summarizer",
        "context-window-packer"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "parameters": {
      "type": "object",
      "maxProperties": 12
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "contains_personal_data"
      ],
      "properties": {
        "classification": {
          "const": "public"
        },
        "contains_personal_data": {
          "const": false
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_response_bytes"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 20000000
        }
      }
    }
  }
}
