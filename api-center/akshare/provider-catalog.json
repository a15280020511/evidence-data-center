{
  "schema_version": "akshare-provider-catalog-v2",
  "ticket_prefix": "[api-akshare]",
  "required_secret_environment_variable": "",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "akshare",
      "display_name": "AKShare 中国金融公开数据",
      "description": "通过固定、只读、限量的AKShare函数读取A股、ETF、资金流、财务报表、板块与中国宏观经济公共数据。",
      "enabled": true,
      "catalog_policy": "GPTs可读取完整固定操作目录并选择高价值只读能力；不得提交任意AKShare函数名、URL、Python代码或动态导入目标。",
      "execution_policy": "每张票据只执行一个固定白名单函数；严格校验证券代码、市场、周期、日期、报表类型、指标枚举、行数和超时；不连接券商、不下单。",
      "operations": [
        {
          "operation_id": "catalog-capabilities",
          "description": "读取AKShare适配器完整安全能力和限制，不访问上游。",
          "parameters": []
        },
        {
          "operation_id": "stock-a-share-spot",
          "description": "读取A股实时行情总表，可按证券代码过滤。",
          "parameters": [
            "symbols",
            "max_rows"
          ]
        },
        {
          "operation_id": "stock-a-share-history",
          "description": "读取单只A股日、周、月历史行情与复权数据。",
          "parameters": [
            "symbol",
            "period",
            "start_date",
            "end_date",
            "adjust",
            "max_rows",
            "timeout_seconds"
          ]
        },
        {
          "operation_id": "stock-company-info",
          "description": "读取单只A股公开公司基础资料。",
          "parameters": [
            "symbol",
            "timeout_seconds"
          ]
        },
        {
          "operation_id": "stock-financial-indicators",
          "description": "读取单只A股财务分析指标。",
          "parameters": [
            "symbol",
            "indicator",
            "max_rows"
          ]
        },
        {
          "operation_id": "stock-financial-report",
          "description": "读取单只A股资产负债表、利润表或现金流量表历史数据。",
          "parameters": [
            "symbol",
            "market",
            "statement_type",
            "max_rows"
          ]
        },
        {
          "operation_id": "stock-fund-flow",
          "description": "读取单只A股近百个交易日资金流向。",
          "parameters": [
            "symbol",
            "market",
            "max_rows"
          ]
        },
        {
          "operation_id": "stock-fund-flow-ranking",
          "description": "读取A股今日、3日、5日或10日资金流排名。",
          "parameters": [
            "indicator",
            "max_rows"
          ]
        },
        {
          "operation_id": "stock-industry-boards",
          "description": "读取A股行业板块实时行情目录。",
          "parameters": [
            "max_rows"
          ]
        },
        {
          "operation_id": "stock-industry-constituents",
          "description": "读取指定行业板块成份股。",
          "parameters": [
            "board_name",
            "max_rows"
          ]
        },
        {
          "operation_id": "fund-etf-spot",
          "description": "读取沪深ETF实时行情总表。",
          "parameters": [
            "symbols",
            "max_rows"
          ]
        },
        {
          "operation_id": "fund-etf-history",
          "description": "读取单只ETF日、周、月历史行情与复权数据。",
          "parameters": [
            "symbol",
            "period",
            "start_date",
            "end_date",
            "adjust",
            "max_rows"
          ]
        },
        {
          "operation_id": "macro-china-gdp",
          "description": "读取中国国内生产总值时间序列。",
          "parameters": [
            "max_rows"
          ]
        },
        {
          "operation_id": "macro-china-cpi",
          "description": "读取中国居民消费价格指数时间序列。",
          "parameters": [
            "max_rows"
          ]
        },
        {
          "operation_id": "macro-china-ppi",
          "description": "读取中国工业品出厂价格指数时间序列。",
          "parameters": [
            "max_rows"
          ]
        },
        {
          "operation_id": "macro-china-pmi",
          "description": "读取中国采购经理人指数时间序列。",
          "parameters": [
            "max_rows"
          ]
        },
        {
          "operation_id": "macro-china-lpr",
          "description": "读取中国贷款市场报价利率时间序列。",
          "parameters": [
            "max_rows"
          ]
        }
      ],
      "limits": {
        "max_rows_default": 500,
        "max_rows_hard": 5000,
        "timeout_seconds_default": 20,
        "timeout_seconds_hard": 60,
        "arbitrary_functions_allowed": false,
        "arbitrary_urls_allowed": false,
        "brokerage_execution_allowed": false,
        "fixed_akshare_functions": 16,
        "max_response_bytes": 5000000
      }
    },
    {
      "provider_id": "ashare",
      "display_name": "Ashare 轻量 A 股行情",
      "description": "兼容 Ashare get_price 语义，通过固定腾讯与新浪公开行情端点读取A股、指数和基金日周月线及分钟线。",
      "enabled": true,
      "ticket_prefix": "[api-ashare]",
      "catalog_policy": "GPTs只能选择固定 ashare-get-price 操作；不能提交任意URL、函数、请求头、脚本或Python代码。",
      "execution_policy": "每张票据只读取一个证券代码；腾讯为主源，新浪为备用；限制周期、行数、超时和响应大小；不下单、不连接券商。",
      "operations": [
        {
          "operation_id": "ashare-get-price",
          "description": "按证券代码、周期、数量和结束日期读取规范化OHLCV行情。",
          "parameters": [
            "symbol",
            "frequency",
            "count",
            "end_date",
            "source",
            "timeout_seconds"
          ]
        }
      ],
      "limits": {
        "count_default": 120,
        "count_hard": 1000,
        "timeout_seconds_default": 15,
        "timeout_seconds_hard": 30,
        "sources": [
          "auto",
          "tencent",
          "sina"
        ],
        "frequencies": [
          "1d",
          "1w",
          "1M",
          "1m",
          "5m",
          "15m",
          "30m",
          "60m"
        ],
        "arbitrary_functions_allowed": false,
        "arbitrary_urls_allowed": false,
        "brokerage_execution_allowed": false
      }
    }
  ]
}
