        {"operation_id":"source","description":"读取一个经济数据来源。","parameters":["source_id"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["source_id"],"properties":{"source_id":{"type":"integer","minimum":1,"maximum":2147483647}}},"result_contract":{"provider":"fred","path":"/fred/source","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"source-releases","description":"读取指定来源对应的发布。","parameters":["source_id","limit","offset","order_by","sort_order"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["source_id"],"properties":{"source_id":{"type":"integer","minimum":1,"maximum":2147483647},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"order_by":{"type":"string","enum":["release_id","name","press_release","realtime_start","realtime_end"]},"sort_order":{"type":"string","enum":["asc","desc"]}}},"result_contract":{"provider":"fred","path":"/fred/source/releases","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"tags","description":"读取或搜索FRED标签。","parameters":["tag_names","tag_group_id","search_text","limit","offset","order_by","sort_order"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"tag_names":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":100}},"tag_group_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,32}$"},"search_text":{"type":"string","minLength":1,"maxLength":200},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"order_by":{"type":"string","enum":["series_count","popularity","created","name","group_id"]},"sort_order":{"type":"string","enum":["asc","desc"]}}},"result_contract":{"provider":"fred","path":"/fred/tags","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"related-tags","description":"读取与给定标签关联的标签。","parameters":["tag_names","exclude_tag_names","tag_group_id","search_text","limit","offset","order_by","sort_order"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["tag_names"],"properties":{"tag_names":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":100}},"exclude_tag_names":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":100}},"tag_group_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,32}$"},"search_text":{"type":"string","minLength":1,"maxLength":200},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"order_by":{"type":"string","enum":["series_count","popularity","created","name","group_id"]},"sort_order":{"type":"string","enum":["asc","desc"]}}},"result_contract":{"provider":"fred","path":"/fred/related_tags","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
