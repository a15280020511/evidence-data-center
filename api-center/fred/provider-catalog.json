{
  "schema_version": "fred-provider-catalog-v1",
  "secret_values_exposed": false,
  "replaced_legacy_connectors": [],
  "providers": [
    {
      "provider_id": "fred",
      "display_name": "FRED 官方经济与金融时间序列",
      "description": "通过圣路易斯联邦储备银行官方 FRED API v1 读取 FRED/ALFRED 分类、发布、序列、观测值、修订日期、来源和标签数据。",
      "enabled": true,
      "ticket_prefix": "[intel-fred]",
      "required_secret_environment_variable": "FRED_API_KEY",
      "catalog_policy": "开放25项固定只读JSON能力；禁止API v2批量发布下载、Maps shape文件、任意URL、路径、请求头、客户端密钥、自动翻页和写操作。",
      "execution_policy": "FRED_API_KEY仅由GitHub Actions后端注入查询参数；每张票据最多一次GET，不自动重试、不跟随重定向，limit最大1000。",
      "official_documentation": "https://fred.stlouisfed.org/docs/api/fred/",
      "official_origin": "https://api.stlouisfed.org/fred",
      "limits": {
        "requests_per_ticket_max": 1,
        "transient_retry_max": 0,
        "provider_concurrency_max": 1,
        "timeout_seconds_max": 60,
        "max_response_bytes": 10000000,
        "rows_per_request_max": 1000,
        "fixed_api_host": "api.stlouisfed.org",
        "fixed_api_prefix": "/fred",
        "automatic_pagination_allowed": false,
        "bulk_v2_release_download_allowed": false,
        "maps_shapefile_download_allowed": false,
        "arbitrary_urls_allowed": false,
        "arbitrary_hosts_allowed": false,
        "arbitrary_paths_allowed": false,
        "arbitrary_headers_allowed": false,
        "arbitrary_query_parameters_allowed": false,
        "client_supplied_credentials_allowed": false,
        "redirects_allowed": false,
        "write_operations_allowed": false,
        "secret_values_exposed": false,
        "authentication_required": true
      },
      "operations": [
        {"operation_id":"catalog-capabilities","description":"读取本地FRED安全能力目录，不访问上游。","parameters":[],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{},"maxProperties":0},"result_contract":{"provider":"fred","http_method":"LOCAL","read_only":true,"credential_mode":"none"}},
        {"operation_id":"category","description":"读取一个FRED分类。","parameters":["category_id"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["category_id"],"properties":{"category_id":{"type":"integer","minimum":0,"maximum":2147483647}}},"result_contract":{"provider":"fred","path":"/fred/category","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"category-children","description":"读取一个分类的直接子分类。","parameters":["category_id"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["category_id"],"properties":{"category_id":{"type":"integer","minimum":0,"maximum":2147483647}}},"result_contract":{"provider":"fred","path":"/fred/category/children","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"category-related","description":"读取一个分类的相关分类。","parameters":["category_id"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["category_id"],"properties":{"category_id":{"type":"integer","minimum":0,"maximum":2147483647}}},"result_contract":{"provider":"fred","path":"/fred/category/related","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"category-series","description":"读取指定分类中的经济序列。","parameters":["category_id","limit","offset","order_by","sort_order"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["category_id"],"properties":{"category_id":{"type":"integer","minimum":0,"maximum":2147483647},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"order_by":{"type":"string","enum":["series_id","title","units","frequency","seasonal_adjustment","realtime_start","realtime_end","last_updated","observation_start","observation_end","popularity","group_popularity"]},"sort_order":{"type":"string","enum":["asc","desc"]}}},"result_contract":{"provider":"fred","path":"/fred/category/series","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"releases","description":"读取全部经济数据发布目录。","parameters":["limit","offset","order_by","sort_order"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"order_by":{"type":"string","enum":["release_id","name","press_release","realtime_start","realtime_end"]},"sort_order":{"type":"string","enum":["asc","desc"]}}},"result_contract":{"provider":"fred","path":"/fred/releases","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"releases-dates","description":"读取所有发布的发布日期。","parameters":["limit","offset","sort_order","include_release_dates_with_no_data"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"sort_order":{"type":"string","enum":["asc","desc"]},"include_release_dates_with_no_data":{"type":"boolean"}}},"result_contract":{"provider":"fred","path":"/fred/releases/dates","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"release","description":"读取一个经济数据发布。","parameters":["release_id"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["release_id"],"properties":{"release_id":{"type":"integer","minimum":1,"maximum":2147483647}}},"result_contract":{"provider":"fred","path":"/fred/release","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"release-dates","description":"读取指定发布的历史发布日期。","parameters":["release_id","limit","offset","sort_order","include_release_dates_with_no_data"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["release_id"],"properties":{"release_id":{"type":"integer","minimum":1,"maximum":2147483647},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"sort_order":{"type":"string","enum":["asc","desc"]},"include_release_dates_with_no_data":{"type":"boolean"}}},"result_contract":{"provider":"fred","path":"/fred/release/dates","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"release-series","description":"读取指定发布包含的经济序列。","parameters":["release_id","limit","offset","order_by","sort_order"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["release_id"],"properties":{"release_id":{"type":"integer","minimum":1,"maximum":2147483647},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"order_by":{"type":"string","enum":["series_id","title","units","frequency","seasonal_adjustment","realtime_start","realtime_end","last_updated","observation_start","observation_end","popularity","group_popularity"]},"sort_order":{"type":"string","enum":["asc","desc"]}}},"result_contract":{"provider":"fred","path":"/fred/release/series","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"release-sources","description":"读取指定发布的数据来源。","parameters":["release_id"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["release_id"],"properties":{"release_id":{"type":"integer","minimum":1,"maximum":2147483647}}},"result_contract":{"provider":"fred","path":"/fred/release/sources","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"series","description":"读取一个FRED经济序列的元数据。","parameters":["series_id","realtime_start","realtime_end"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["series_id"],"properties":{"series_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,64}$"},"realtime_start":{"type":"string","format":"date"},"realtime_end":{"type":"string","format":"date"}}},"result_contract":{"provider":"fred","path":"/fred/series","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"series-categories","description":"读取一个序列所属分类。","parameters":["series_id","realtime_start","realtime_end"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["series_id"],"properties":{"series_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,64}$"},"realtime_start":{"type":"string","format":"date"},"realtime_end":{"type":"string","format":"date"}}},"result_contract":{"provider":"fred","path":"/fred/series/categories","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"series-observations","description":"读取一个序列的观测值，可限定观测日期、实时期、单位和频率。","parameters":["series_id","observation_start","observation_end","realtime_start","realtime_end","limit","offset","sort_order","units","frequency","aggregation_method","output_type","vintage_dates"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["series_id"],"properties":{"series_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,64}$"},"observation_start":{"type":"string","format":"date"},"observation_end":{"type":"string","format":"date"},"realtime_start":{"type":"string","format":"date"},"realtime_end":{"type":"string","format":"date"},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"sort_order":{"type":"string","enum":["asc","desc"]},"units":{"type":"string","enum":["lin","chg","ch1","pch","pc1","pca","cch","cca","log"]},"frequency":{"type":"string","enum":["d","w","bw","m","q","sa","a","wef","weth","wew","wetu","wem","wesu","wesa","bwew","bwem"]},"aggregation_method":{"type":"string","enum":["avg","sum","eop"]},"output_type":{"type":"integer","minimum":1,"maximum":4},"vintage_dates":{"type":"array","minItems":1,"maxItems":50,"uniqueItems":true,"items":{"type":"string","format":"date"}}}},"result_contract":{"provider":"fred","path":"/fred/series/observations","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"series-release","description":"读取一个序列对应的数据发布。","parameters":["series_id","realtime_start","realtime_end"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["series_id"],"properties":{"series_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,64}$"},"realtime_start":{"type":"string","format":"date"},"realtime_end":{"type":"string","format":"date"}}},"result_contract":{"provider":"fred","path":"/fred/series/release","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"series-search","description":"按关键词或序列ID搜索经济序列。","parameters":["search_text","search_type","limit","offset","order_by","sort_order"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["search_text"],"properties":{"search_text":{"type":"string","minLength":1,"maxLength":200},"search_type":{"type":"string","enum":["full_text","series_id"]},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"order_by":{"type":"string","enum":["search_rank","series_id","title","units","frequency","seasonal_adjustment","realtime_start","realtime_end","last_updated","observation_start","observation_end","popularity","group_popularity"]},"sort_order":{"type":"string","enum":["asc","desc"]}}},"result_contract":{"provider":"fred","path":"/fred/series/search","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"series-updates","description":"读取FRED服务器最近更新的经济序列。","parameters":["limit","offset","filter_value"],"parameter_schema":{"type":"object","additionalProperties":false,"properties":{"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"filter_value":{"type":"string","enum":["all","macro","regional"]}}},"result_contract":{"provider":"fred","path":"/fred/series/updates","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
        {"operation_id":"series-vintagedates","description":"读取一个序列发生修订或新增观测的历史日期。","parameters":["series_id","limit","offset","sort_order"],"parameter_schema":{"type":"object","additionalProperties":false,"required":["series_id"],"properties":{"series_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,64}$"},"limit":{"type":"integer","minimum":1,"maximum":1000},"offset":{"type":"integer","minimum":0,"maximum":100000},"sort_order":{"type":"string","enum":["asc","desc"]}}},"result_contract":{"provider":"fred","path":"/fred/series/vintagedates","http_method":"GET","read_only":true,"credential_mode":"api_key_query_backend_only"}},
