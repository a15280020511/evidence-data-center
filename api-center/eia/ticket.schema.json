{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/evidence-data-center/api-center/eia/ticket.schema.json",
  "title": "U.S. EIA API v2 bounded read-only ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "provider", "operation", "objective", "parameters", "data_policy", "acceptance"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "provider": {"const": "eia"},
    "operation": {
      "type": "string",
      "enum": ["catalog-capabilities", "api-root", "route-metadata", "facet-values", "route-data", "series-by-id"]
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
    "parameters": {"type": "object", "maxProperties": 10},
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {
        "classification": {"const": "public"},
        "contains_personal_data": {"const": false}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_response_bytes"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 60},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 20000000}
      }
    }
  }
}
