{
  "schema_version": "global-source-discovery-config-v2",
  "deployment_revision": 2,
  "schedule_timezone": "Asia/Seoul",
  "daily_query_limit": 24,
  "apis_guru_batch_size": 120,
  "max_new_candidates_per_run": 500,
  "max_probe_count_per_run": 80,
  "auto_integrate_score": 72,
  "key_notification_score": 78,
  "query_planner": {
    "version": "v4",
    "strategy": "short-platform-aware-query-families",
    "maximum_optional_constraints": 2,
    "gap_driven_priority": true,
    "trend_signal_weight_max": 0.1,
    "registry_first": true
  },
  "google_trends": {
    "enabled": true,
    "role": "auxiliary-vocabulary-and-emerging-topic-signal-only",
    "rss_url_template": "https://trends.google.com/trending/rss?geo={geo}",
    "rss_geos": ["US", "KR", "JP", "IN", "GB", "DE", "FR", "BR", "MX", "CA", "AU", "ZA"],
    "max_terms_per_run": 20,
    "max_feed_bytes": 1000000,
    "max_query_share": 0.1,
    "relevance_markers": [
      "AI", "artificial intelligence", "API", "MCP", "model context protocol",
      "data", "dataset", "database", "search", "browser", "crawler", "OCR",
      "open source", "Python", "Julia", "GitHub", "software", "cybersecurity",
      "satellite", "climate", "finance", "economy", "semiconductor", "robotics"
    ],
    "fail_closed": true,
    "never_override": ["coverage gaps", "official registries", "free gate", "license gate", "security gate"]
  },
  "allowed_source_types": [
    "rest_api", "openapi", "graphql", "remote_mcp", "ckan", "socrata",
    "arcgis_rest", "stac", "sparql", "sdmx", "oai_pmh", "rss_atom",
    "bulk_download", "web_read"
  ],
  "forbidden_automatic_actions": [
    "execute local MCP servers",
    "install npm, pip, Docker or binary packages from discovered sources",
    "submit credentials",
    "perform write operations",
    "bypass robots.txt, access controls, paywalls or rate limits",
    "collect private or personal data",
    "follow non-HTTPS endpoints",
    "enable sources with unclear or prohibited terms"
  ],
  "trusted_domain_suffixes": [
    ".gov", ".gov.cn", ".gov.uk", ".gov.au", ".gov.br", ".gov.in",
    ".gov.sg", ".gob.mx", ".gouv.fr", ".go.jp", ".go.kr", ".edu",
    ".ac.uk", ".ac.jp", ".ac.kr", ".edu.cn", ".int", ".europa.eu",
    ".un.org", ".worldbank.org", ".imf.org", ".oecd.org", ".bis.org"
  ],
  "trusted_exact_domains": [
    "api.apis.guru", "github.com", "raw.githubusercontent.com", "data.europa.eu",
    "data.gov", "data.gov.uk", "data.gov.cn", "data.un.org", "data.worldbank.org",
    "api.worldbank.org", "openalex.org", "api.openalex.org", "crossref.org",
    "api.crossref.org", "zenodo.org", "figshare.com", "dataverse.org", "re3data.org"
  ],
  "protocol_keywords": [
