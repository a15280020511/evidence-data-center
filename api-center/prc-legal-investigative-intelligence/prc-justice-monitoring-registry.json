{
  "schema_version": "prc-justice-monitoring-registry-v1",
  "reviewed_at": "2026-08-07",
  "jurisdiction": "PRC_MAINLAND",
  "purpose": "持续监控中国大陆公开或明确授权的政法、司法、纪检监察制度、培训、标准、科研和案例变化，并把变化映射回完整司法节点DAG。",
  "monitoring_policy": {
    "mode": "bounded_read_only_public_source_monitoring",
    "daily_priority_sources_max": 20,
    "concurrency": 1,
    "minimum_interval_seconds_for_prc_primary_hosts": 10,
    "automatic_retry": false,
    "automatic_login": false,
    "captcha_solving": false,
    "waf_bypass": false,
    "hidden_api_reverse_engineering": false,
    "stop_on": ["401", "403", "429", "login_required", "captcha", "waf", "provider_denial", "terms_or_authorization_uncertainty"],
    "change_detection": ["publication_date", "title", "document_identifier", "effective_date", "status", "content_fingerprint", "source_url"],
    "cadence": {
      "A_DAILY": "国家法源、两高、公安、司法部、纪委监委、政法委及关键专项执法公开更新",
      "B_3DAY": "培训、技术标准、司法鉴定、专业媒体与地方重点来源",
      "C_WEEKLY": "全国地方来源族、院校科研、专业期刊、学术索引完整扫描"
    },
    "primary_source_rule": "搜索引擎、新闻聚合和学术索引只负责发现；重大事实必须回到一手官方来源或原始论文/案例核验。"
  },
