  "retrieval_policy": {
    "priority": [
      "documented_official_api",
      "official_rss_atom_sitemap_or_bulk_download",
      "official_html_pdf_xlsx_csv_xml_json",
      "official_search_database_bounded_query",
      "existing_governed_web_retrieval",
      "manual_or_authorized_export"
    ],
    "automatic_login_allowed": false,
    "captcha_solving_allowed": false,
    "waf_bypass_allowed": false,
    "403_or_429_origin_switch_allowed": false,
    "hidden_api_reverse_engineering_allowed": false,
    "unbounded_pagination_allowed": false,
    "incremental_collection_preferred": true,
    "detail_page_read_only": true,
    "existing_provider_reuse_required": true
  },
