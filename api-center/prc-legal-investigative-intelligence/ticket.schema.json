{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-system.example/schemas/prc-legal-investigative-ticket-v2.json",
  "title": "PRC Legal Investigative Intelligence Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "provider", "operation", "objective", "parameters", "data_policy", "acceptance"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,119}$"},
    "provider": {"const": "prc-legal-investigative-intelligence"},
    "operation": {"type": "string", "enum": ["catalog-capabilities", "source-catalog", "source-route", "investigative-evidence-matrix", "joint-audit-plan"]},
    "objective": {"type": "string", "minLength": 3, "maxLength": 1500},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": {"type": "string", "minLength": 1, "maxLength": 80},
        "access_class": {"type": "string", "minLength": 1, "maxLength": 80},
        "evidence_weight": {"type": "string", "minLength": 1, "maxLength": 80},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
        "risk_topics": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {
        "classification": {"const": "public"},
        "contains_personal_data": {"const": false},
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 30},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 5000000}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "catalog-capabilities"}}},
      "then": {"properties": {"parameters": {"maxProperties": 0}}}
    },
    {
      "if": {"properties": {"operation": {"const": "source-route"}}},
      "then": {"properties": {"parameters": {"required": ["source_id"], "maxProperties": 1}}}
    },
    {
      "if": {"properties": {"operation": {"const": "investigative-evidence-matrix"}}},
      "then": {"properties": {"parameters": {"not": {"anyOf": [{"required": ["source_id"]}, {"required": ["access_class"]}, {"required": ["evidence_weight"]}, {"required": ["risk_topics"]}]}}}}
    },
    {
      "if": {"properties": {"operation": {"const": "joint-audit-plan"}}},
      "then": {"properties": {"parameters": {"not": {"anyOf": [{"required": ["source_id"]}, {"required": ["topic"]}, {"required": ["access_class"]}, {"required": ["evidence_weight"]}, {"required": ["limit"]}]}}}}
    }
  ]
}
