{
  "schema_version": "prc-legal-system-matrix-v1",
  "reviewed_at": "2026-08-07",
  "jurisdiction": "PRC_MAINLAND",
  "purpose": "Nationwide public-source legal-system matrix combining YuanDian recall with current official legislation, courts, procuratorates, public-security procedure, justice administration, administrative review/enforcement, dispute resolution and specialized adjudication sources. It is for defensive legal research and compliance only.",
  "safety_boundary": {
    "public_or_authorized_sources_only": true,
    "automatic_login_allowed": false,
    "captcha_or_waf_bypass_allowed": false,
    "hidden_api_reverse_engineering_allowed": false,
    "investigation_evasion_allowed": false,
    "personal_targeting_allowed": false,
    "official_current_text_controls_final_validation": true
  },
  "pairing_model": {
    "recall_layer": "yuandian-law",
    "official_validation_layers": [
      "national_legislation",
      "court_system",
      "procuratorate_system",
      "public_security_and_investigation",
      "justice_administration",
      "administrative_review_and_enforcement",
      "specialized_adjudication_and_execution"
    ],
    "rule": "Use YuanDian for broad statute/case recall and terminology expansion. Verify material propositions against current official law, judicial/procuratorial materials, official case/publication systems and provider authorization terms before a final risk decision."
  },
