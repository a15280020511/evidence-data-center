{
  "schema_version": "prc-justice-knowledge-practice-matrix-v2",
  "reviewed_at": "2026-08-07",
  "jurisdiction": "PRC_MAINLAND",
  "purpose": "Combine nationwide public legal/judicial/public-security/supervision education, standards, research, official media and public case outcomes to understand declared doctrine, evidence logic and demonstrated capability for defensive legal/compliance review.",
  "safety_boundary": {
    "public_or_authorized_sources_only": true,
    "secret_or_internal_material_allowed": false,
    "operational_surveillance_details_allowed": false,
    "targeting_or_evasion_guidance_allowed": false,
    "anti_forensics_allowed": false,
    "private_training_platform_login_allowed": false,
    "training_material_ingestion_mode": "public_metadata_course_titles_official_summaries_and_high_level_capability_abstraction_only",
    "case_ingestion_mode": "public_fact_pattern_evidence_chain_procedure_and_outcome_only",
    "standards_ingestion_mode": "public_title_scope_status_and_lawfully_public_text_only",
    "copyrighted_text_ingestion_mode": "metadata_abstract_toc_or_lawfully_open_text_only"
  },
  "two_view_model": {
    "source_view": "Use public laws, curricula, training metadata, standards, official research, public journals and institutional media to infer declared legal/technical capability domains.",
    "outcome_view": "Use YuanDian recall plus verified court, procuratorial, public-security, supervision and forensic public cases to infer demonstrated evidence combinations and procedural practice.",
    "cross_validation_rule": "A capability is stronger when independent source-view and outcome-view materials converge. Final legal conclusions still require current official law and primary-source verification."
  },
  "coverage_groups": [
    "national_legislation_and_procedure",
    "courts_and_judicial_training",
    "procuratorates_and_procuratorial_technology",
