{
  "schema_version": "prc-justice-self-iteration-policy-v1",
  "reviewed_at": "2026-08-07",
  "jurisdiction": "PRC_MAINLAND",
  "purpose": "定时从公开或明确授权的一手来源发现中国大陆司法、公安、检察、纪检监察和司法鉴定的新案例实践，提取允许的高层侦查/网络侦查/刑事技术证据能力观察，并以可复核、可验证、可吸收、可迭代的方式增量更新案件能力账本。",
  "safety_boundary": {
    "public_or_authorized_sources_only": true,
    "primary_source_required_for_automatic_absorption": true,
    "automatic_login": false,
    "captcha_solving": false,
    "waf_bypass": false,
    "hidden_api_reverse_engineering": false,
    "proxy_or_identity_rotation": false,
    "secret_internal_system_collection": false,
    "covert_surveillance_implementation_details": false,
    "target_selection_or_tracking_playbook": false,
    "investigation_evasion": false,
    "anti_forensics": false,
    "evidence_destruction": false,
    "operational_tactical_playbook": false,
    "personal_targeting": false
  },
  "cadence": {
    "workflow_cron_utc": "20 3 * * *",
    "daily_profile": "每天执行有限案例发现、复核和既有能力账本增量",
    "weekly_profile": "UTC周日自动扩大到培训、标准、科研与更多专项执法来源，用于源头侧再验证",
    "maximum_age_days_for_search": 60
  },
  "limits": {
    "search_queries_per_engine_daily": 6,
    "search_queries_per_engine_weekly": 10,
    "search_results_per_query": 6,
    "max_unique_candidate_urls": 40,
    "max_primary_pages_fetched": 12,
    "max_new_observations_per_run": 8,
    "max_capability_ids_per_observation": 7,
    "max_page_bytes": 524288,
    "request_timeout_seconds": 18,
    "minimum_seconds_between_prc_primary_fetches": 10,
    "automatic_retry": false
  },
  "primary_outcome_hosts": [
    "spp.gov.cn",
    "court.gov.cn",
    "rmfyalk.court.gov.cn",
    "mps.gov.cn",
    "ccdi.gov.cn",
    "moj.gov.cn",
    "customs.gov.cn",
    "nia.gov.cn",
    "ccg.gov.cn"
  ],
  "source_view_hosts": [
    "ywtb.mps.gov.cn",
    "std.samr.gov.cn",
    "ppsuc.edu.cn",
    "cipuc.edu.cn",
    "cppu.edu.cn",
    "njpu.edu.cn",
    "rpc.edu.cn",
    "ssfjd.com",
    "ssfjd.cn",
    "chinapeace.gov.cn",
    "chinalaw.org.cn"
  ],
  "daily_queries": [
    "site:spp.gov.cn 典型案例 检察技术 电子数据 技术性证据审查",
    "site:spp.gov.cn 网络犯罪 电子数据 证据审查 案例",
    "site:court.gov.cn OR site:rmfyalk.court.gov.cn 网络犯罪 电子数据 证据 案例",
    "site:mps.gov.cn 网络犯罪 电子数据 刑事技术 案例",
    "site:ccdi.gov.cn 审查调查 数据 证据 技术 案例",
    "site:customs.gov.cn OR site:nia.gov.cn OR site:ccg.gov.cn 侦查 电子数据 技术 案例"
  ],
  "weekly_extra_queries": [
    "site:ywtb.mps.gov.cn 电子物证 刑事技术 标准",
    "site:cipuc.edu.cn OR site:ppsuc.edu.cn OR site:cppu.edu.cn 网络犯罪侦查 电子数据取证 科研 课程",
    "site:ssfjd.com OR site:ssfjd.cn 电子数据 司法鉴定 标准 案例",
    "site:spp.gov.cn 检察技术 数据分析 遥感 影像 鉴定 典型案例"
  ],
  "case_signals": [
    "典型案例",
    "指导性案例",
    "参考案例",
    "案件",
    "侦查",
    "审查起诉",
    "技术性证据审查",
    "审查调查",
    "判决",
    "检察建议",
    "调查核实"
  ],
