    "network-crime-investigation": ["网络犯罪", "涉网案件", "网络案件", "网络犯罪侦查"],
    "electronic-data-forensics": ["电子数据", "电子物证", "数据取证", "电子数据取证", "存储介质"],
    "network-log-and-connection-evidence": ["登录日志", "访问日志", "应用日志", "网络连接记录", "通信日志"],
