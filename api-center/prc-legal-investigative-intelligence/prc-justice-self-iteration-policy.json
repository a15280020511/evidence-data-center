    "video-image-investigation": ["视频侦查", "视频图像", "图像检验", "影像检验", "视频资料"],
    "audio-voice-evidence": ["音频取证", "声纹", "语音检验", "录音资料"],
    "fingerprint-trace-document-forensics": ["指纹", "手印", "足迹", "工具痕迹", "文件检验", "痕迹检验"],
    "forensic-medicine-and-dna": ["DNA", "法医", "生物物证", "医学影像", "伤情鉴定", "病理材料"],
    "toxicology-chemistry-microtrace": ["毒物分析", "毒品检验", "理化检验", "微量物证", "化学检验"],
    "geospatial-remote-sensing-and-mapping": ["遥感", "卫星影像", "无人机航拍", "三维建模", "地理空间", "测绘数据"],
    "technical-evidence-specialist-review": ["技术性证据审查", "技术审查", "鉴定意见审查", "电子数据审查"],
    "provider-and-institutional-assistance": ["依法调取", "协助提供", "平台协助", "运营商协助", "机构记录"],
    "interagency-evidence-cooperation": ["侦查监督", "提前介入", "引导侦查", "跨部门协作", "检警协作", "技术协助"],
    "technical-investigation-legal-category": ["技术侦查措施", "技术侦查"]
  },
  "evidence_token_patterns": {
    "original_electronic_data": ["原始电子数据", "原始数据"],
    "application_or_login_logs": ["应用日志", "登录日志", "访问日志"],
    "network_connection_records": ["网络连接记录", "连接记录"],
    "platform_or_cloud_records": ["平台数据", "平台记录", "云端数据", "运营商记录"],
    "transaction_records": ["资金流", "银行流水", "交易记录", "支付记录"],
    "communication_records": ["聊天记录", "短信记录", "邮件记录", "通信记录"],
    "video_image_material": ["视频资料", "视频图像", "影像资料"],
    "audio_material": ["录音资料", "音频资料", "声纹"],
    "forensic_or_appraisal_opinion": ["鉴定意见", "检验报告", "鉴定报告"],
    "medical_or_biological_material": ["医学影像", "病理材料", "DNA", "生物物证"],
    "remote_sensing_or_geospatial_data": ["遥感", "卫星影像", "无人机航拍", "三维建模", "测绘数据"],
    "field_verification": ["现场核实", "现场勘验", "实地调查"]
  },
  "procedural_stage_patterns": {
    "procuratorial_technical_evidence_review": ["技术性证据审查", "审查起诉", "检察技术"],
    "public_security_investigation": ["公安机关立案侦查", "侦查机关", "侦查阶段"],
    "adjudication": ["人民法院判决", "法院判决", "一审", "二审"],
    "discipline_supervision_investigation": ["审查调查", "监察调查"],
    "public_interest_investigation_verification": ["公益诉讼", "调查核实", "检察建议"]
  },
  "outcome_patterns": {
    "court_judgment": ["法院判决", "人民法院判决"],
    "prosecution": ["提起公诉", "依法起诉"],
    "non_prosecution": ["不起诉"],
    "procuratorial_recommendation": ["检察建议"],
    "discipline_or_supervision_disposition": ["党纪政务处分", "移送检察机关"]
  },
  "verification_and_iteration": {
    "new_primary_case_observation_level": "PRIMARY_OBSERVED",
    "automatic_promotion_maximum": "CORROBORATED_PRACTICE",
    "corroborated_minimum_independent_observations": 2,
    "strongly_corroborated_requires_explicit_manual_or_governance_source_view_check": true,
    "single_case_never_generalizes_nationwide": true,
    "conflict_signal_forces_review_instead_of_auto_absorption": true,
    "unmapped_new_technology_never_auto_adds_a_capability_id": true,
    "law_or_standard_change_requires_revalidation": true,
    "append_only_observation_history": true,
    "existing_observations_must_not_be_deleted_by_automation": true,
    "deduplicate_by_primary_url_and_source_fingerprint": true
  },
  "automation_gate": {
    "auto_pr_allowed": true,
    "auto_merge_only_if": [
      "all_new_observations_primary_official",
      "all_capabilities_already_exist_in_matrix",
      "no_conflict_or_review_signal",
      "no_sensitive_operational_signal",
      "no_existing_observation_deleted_or_mutated",
      "deterministic_learning_validator_passes",
      "prc_legal_investigative_validator_passes",
      "prc_compliance_validator_passes",
      "required_dispatched_checks_pass"
    ],
    "never_admin_bypass_branch_protection": true,
    "on_gate_failure": "preserve_artifact_and_leave_reviewable_PR_or_issue_without_merging"
  }
}
