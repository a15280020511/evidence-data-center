{
  "schema_version": "prc-justice-verified-signal-ledger-v1",
  "reviewed_at": "2026-08-07",
  "jurisdiction": "PRC_MAINLAND",
  "purpose": "保存已经回到公开或明确授权的一手页面复核的司法能力、实践标准、技术、法律理论与执行趋势信号。只保存结构化元数据、分类和来源指纹，不保存整页正文。",
  "safety_boundary": {
    "public_or_authorized_sources_only": true,
    "full_page_text_stored": false,
    "personal_targeting": false,
    "secret_operational_details": false,
    "targeting_or_evasion_details": false,
    "anti_forensics": false,
    "history_deletion_on_conflict": false
  },
  "events": [],
  "iteration_rules": {
    "append_only_history": true,
    "deduplicate_by_event_id_and_source_fingerprint": true,
    "source_page_required_for_primary_verified": true,
    "discovery_result_alone_never_enters_ledger": true,
    "historical_or_undated_candidate_requires_review": true,
    "conflict_is_preserved_not_deleted": true,
    "model_interpretation_is_not_primary_fact": true
  }
}
