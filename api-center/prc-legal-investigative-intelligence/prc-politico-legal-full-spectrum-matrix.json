{
  "schema_version": "prc-politico-legal-full-spectrum-matrix-v1",
  "reviewed_at": "2026-08-07",
  "jurisdiction": "PRC_MAINLAND",
  "purpose": "Provide a nationwide public-source map of China's politico-legal, judicial, procuratorial, public-security, justice-administration, discipline-inspection/supervision, specialized criminal-enforcement, education/training, standards/research and case-outcome ecosystems for defensive legal/compliance research.",
  "coverage_contract": {
    "scope": "all material public-or-authorized source families, not a claim that every record or nonpublic internal system is mirrored locally",
    "inherit_existing_matrices": [
      "legal-system-matrix.json",
      "investigative-evidence-matrix.json",
      "public-security-knowledge-practice-matrix.json",
      "source-catalog.json"
    ],
    "dynamic_local_discovery": true,
    "official_primary_source_priority": true,
    "yuan_dian_role": "broad statute/case recall and terminology expansion",
    "final_validation_role": "current official law and primary institutional/case source"
  },
  "safety_boundary": {
    "public_or_authorized_sources_only": true,
    "authenticated_party_case_auto_login_allowed": false,
    "private_training_platform_auto_login_allowed": false,
    "captcha_or_waf_bypass_allowed": false,
    "hidden_api_reverse_engineering_allowed": false,
    "secret_or_internal_operational_material_allowed": false,
    "covert_surveillance_implementation_details_allowed": false,
    "target_selection_guidance_allowed": false,
    "investigation_evasion_allowed": false,
    "anti_forensics_allowed": false,
    "evidence_destruction_allowed": false,
    "course_ingestion_rule": "public course titles, curricula, training notices, official summaries, open teaching materials and high-level competency taxonomy only",
    "case_ingestion_rule": "public facts, evidence categories, corroboration structure, procedure, admissibility discussion and outcome only",
    "copyright_rule": "metadata, abstracts, tables of contents and lawfully open full text only"
  },
  "knowledge_layers": [
    {"layer_id":"normative_governance","name":"规范与治理层","content":["laws","judicial_interpretations","party_regulations","discipline_rules","institutional_rules","joint_interagency_rules"]},
    {"layer_id":"institutional_structure","name":"组织与职责层","content":["politico_legal_coordination","court","procuratorate","public_security","state_security_public_law","justice_administration","discipline_supervision","specialized_criminal_enforcement"]},
    {"layer_id":"education_training","name":"学校与培训层","content":["judge_training","prosecutor_training","police_academies","justice_administration_training","discipline_supervision_training","law_school_research_and_teaching"]},
    {"layer_id":"standards_technology_research","name":"标准、技术与科研层","content":["forensic_standards","electronic_evidence_standards","judicial_appraisal","procuratorial_technology","evidence_science","digital_justice","public_research_only"]},
    {"layer_id":"practice_process","name":"办案与实践层","content":["public_procedure","public_case_reports","judicial_disclosure","procuratorial_disclosure","discipline_supervision_public_practice","administrative_review_and_enforcement"]},
    {"layer_id":"case_outcome","name":"案例与结果层","content":["guiding_cases","reference_cases","typical_cases","judgments","procuratorial_cases","public_security_cases","supervision_cases","forensic_cases","execution_bankruptcy_and_sentence_execution"]},
    {"layer_id":"theory_commentary","name":"理论与解释层","content":["official_explanations","institutional_media","law_society_research","academic_literature","professional_journals"]}
  ],
