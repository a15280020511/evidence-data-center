  "cross_validation_model": {
    "source_view": ["law","institution","course","training","standard","research","official_media"],
    "outcome_view": ["case","judgment","prosecution","public_security_case","discipline_supervision_case","forensic_review","execution_result"],
    "high_confidence_rule": "A capability or practice pattern requires at least one primary/official source and preferably convergence between source-view and outcome-view evidence.",
    "no_single_news_rule": true,
    "no_single_secondary_source_rule": true
  },
  "case_derived_fields": [
    "case_source_date_and_authority",
    "case_type_and_jurisdiction",
    "initial_publicly_described_clue_source",
    "publicly_described_evidence_categories",
    "corroboration_graph",
    "identity_or_entity_attribution_factors",
    "forensic_or_technical_review_category",
    "lawful_interagency_or_provider_assistance_if_publicly_stated",
    "procedure_and_admissibility_issues",
    "procuratorial_review_or_supervision_result",
    "court_or_discipline_supervision_outcome",
    "demonstrated_capability_domains",
    "primary_source_status_and_confidence"
  ],
  "forbidden_fields": [
    "secret_internal_system_name",
    "nonpublic_training_content",
    "surveillance_sensor_or_collection_parameters",
    "covert_collection_configuration",
    "target_selection_recipe",
    "detection_threshold_or_blind_spot",
    "credential_or_private_endpoint",
    "anti_forensics_or_investigation_evasion_method",
    "operational_tactical_playbook"
  ],
  "retrieval_policy": {
    "preferred_order": ["official_api_or_feed","official_bulk_download","public_html_pdf_attachment","bounded_public_search_database","controlled_web_retrieval","manual_or_explicitly_authorized_export"],
    "incremental_first": true,
    "bounded_pagination": true,
    "stop_on": ["login_required","captcha","waf","http_403","http_429","provider_denial","terms_or_authorization_uncertainty"],
    "no_bulk_mirroring_when_platform_controls_disallow": true
  },
  "analysis_pipeline": [
    "classify_issue_and_institutional_domain",
    "yuandian_broad_statute_and_case_recall",
    "select_normative_and_institutional_sources",
    "collect_source_view_training_standard_research_metadata",
    "collect_primary_case_outcome_view",
    "cross_validate_theory_training_standard_against_practice_outcome",
    "verify_current_law_procedure_and_evidence_rules",
    "separate_policy_commentary_from_binding_law",
    "issue_defensive_legal_compliance_assessment"
  ]
}
